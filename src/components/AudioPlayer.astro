---
export interface Props {
  text: string;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { text, label, size = 'md' } = Astro.props;
---

<button
  type="button"
  class={`audio-player-btn audio-${size}`}
  data-speech-text={text}
  aria-label={`Listen to pronunciation of Korean name ${text}`}
  title="Listen to native Korean pronunciation"
>
  <svg class="speaker-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
  </svg>
  <span class="sound-wave-anim" aria-hidden="true">
    <span class="wave-bar"></span>
    <span class="wave-bar"></span>
    <span class="wave-bar"></span>
  </span>
  {label && <span class="audio-label">{label}</span>}
</button>

<script>
  // Global Audio Controller using Web Speech API
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('.audio-player-btn') as HTMLElement;
    if (!target) return;

    const speechText = target.dataset.speechText;
    if (!speechText) return;

    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();

      // Reset any active animations on other buttons
      document.querySelectorAll('.audio-player-btn.playing').forEach(b => b.classList.remove('playing'));

      const utterance = new SpeechSynthesisUtterance(speechText);
      utterance.lang = 'ko-KR';
      utterance.rate = 0.85;

      target.classList.add('playing');

      utterance.onend = () => {
        target.classList.remove('playing');
      };

      utterance.onerror = () => {
        target.classList.remove('playing');
      };

      window.speechSynthesis.speak(utterance);
    }
  });
</script>

<style>
  .audio-player-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-full);
    background: var(--brand-teal-light);
    color: var(--brand-teal-deep);
    border: 1px solid var(--brand-teal-border);
    font-size: 0.775rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .audio-player-btn:hover {
    background: var(--brand-teal);
    color: white;
    border-color: var(--brand-teal);
    transform: translateY(-1px);
    box-shadow: var(--shadow-xs);
  }

  .audio-sm {
    padding: 0.2rem 0.45rem;
    font-size: 0.7rem;
  }

  .audio-sm .speaker-icon {
    width: 13px;
    height: 13px;
  }

  .audio-lg {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  .audio-lg .speaker-icon {
    width: 18px;
    height: 18px;
  }

  .sound-wave-anim {
    display: none;
    align-items: center;
    gap: 2px;
    height: 12px;
  }

  .wave-bar {
    width: 2px;
    height: 100%;
    background: currentColor;
    border-radius: 1px;
    animation: waveJump 0.6s ease-in-out infinite alternate;
  }

  .wave-bar:nth-child(2) {
    animation-delay: 0.2s;
  }

  .wave-bar:nth-child(3) {
    animation-delay: 0.4s;
  }

  .audio-player-btn.playing .speaker-icon {
    display: none;
  }

  .audio-player-btn.playing .sound-wave-anim {
    display: inline-flex;
  }

  @keyframes waveJump {
    0% { height: 4px; }
    100% { height: 12px; }
  }
</style>
