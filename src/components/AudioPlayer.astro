---
export interface Props {
  text: string;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { text, label, size = 'md' } = Astro.props;
---

<button
  class={`audio-btn audio-btn-${size}`}
  data-speech-text={text}
  aria-label={`Listen to pronunciation of ${text}`}
  title="Listen to native Korean pronunciation"
>
  <svg class="speaker-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
  </svg>
  <div class="sound-wave-anim">
    <span class="wave-bar"></span>
    <span class="wave-bar"></span>
    <span class="wave-bar"></span>
  </div>
  {label && <span class="audio-label">{label}</span>}
</button>

<script>
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('.audio-btn') as HTMLElement;
    if (!target) return;

    const speechText = target.dataset.speechText;
    if (!speechText) return;

    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();

      const utterance = new SpeechSynthesisUtterance(speechText);
      utterance.lang = 'ko-KR';
      utterance.rate = 0.85; // Slightly slower for clear pronunciation

      target.classList.add('playing');

      utterance.onend = () => {
        target.classList.remove('playing');
      };

      utterance.onerror = () => {
        target.classList.remove('playing');
      };

      window.speechSynthesis.speak(utterance);
    } else {
      alert(`Native audio pronunciation for "${speechText}" requires Web Speech API supported in your browser.`);
    }
  });
</script>

<style>
  .audio-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent-crimson-light);
    color: var(--accent-crimson);
    border: 1px solid rgba(153, 27, 27, 0.2);
    border-radius: var(--radius-full);
    font-weight: 600;
    transition: all 0.2s ease;
    padding: 0.4rem 0.85rem;
  }

  .audio-btn:hover {
    background: var(--accent-crimson);
    color: white;
    box-shadow: var(--shadow-sm);
  }

  .audio-btn-sm {
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
  }

  .audio-btn-lg {
    padding: 0.6rem 1.25rem;
    font-size: 1rem;
  }

  .sound-wave-anim {
    display: none;
    align-items: center;
    gap: 2px;
    height: 16px;
  }

  .audio-btn.playing .speaker-icon {
    display: none;
  }

  .audio-btn.playing .sound-wave-anim {
    display: flex;
  }
</style>
