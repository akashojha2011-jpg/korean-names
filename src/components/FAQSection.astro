---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  faqs: FAQItem[];
  title?: string;
  renderSchema?: boolean;
}

const {
  faqs,
  title = 'Frequently Asked Questions about Korean Names',
  renderSchema = false,
} = Astro.props;

// Prepare Schema.org JSON-LD FAQ structure only when explicitly enabled
const faqSchema = renderSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      'mainEntity': faqs.map((item) => ({
        '@type': 'Question',
        'name': item.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': item.answer,
        },
      })),
    }
  : null;
---

{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<section class="editorial-faq-section" aria-label="Frequently Asked Questions">
  <div class="faq-header">
    <span class="faq-badge">Q&A</span>
    <h2 class="faq-section-title">{title}</h2>
  </div>

  <div class="faq-accordion-list">
    {faqs.map((item, idx) => (
      <details class="faq-accordion-item" open={idx === 0}>
        <summary class="faq-summary">
          <span class="faq-q-text">{item.question}</span>
          <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="faq-answer-body">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .editorial-faq-section {
    margin-top: 3.5rem;
    padding: 2.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }

  .faq-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .faq-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.6rem;
    background: var(--brand-teal-light);
    color: var(--brand-teal-deep);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .faq-section-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-accordion-item {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .faq-accordion-item[open] {
    border-color: var(--brand-teal-border);
    background: var(--brand-teal-surface);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-q-text {
    flex: 1;
    padding-right: 1rem;
  }

  .faq-chevron {
    color: var(--text-muted);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-accordion-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--brand-teal-deep);
  }

  .faq-answer-body {
    padding: 0 1.25rem 1.25rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-body);
  }

  .faq-answer-body p {
    margin: 0;
  }
</style>
