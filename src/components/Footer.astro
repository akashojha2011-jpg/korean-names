---
const currentYear = new Date().getFullYear();
---

<footer class="editorial-footer">
  <div class="container footer-content-grid">
    
    <!-- Column 1: Brand & Cultural Mission -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-brand" aria-label="Korean Names Homepage">
        <img
          src="/logo.jpg"
          alt="Korean Names Logo"
          width="40"
          height="40"
          class="footer-logo-img"
          loading="lazy"
        />
        <span class="footer-brand-title">Korean Names</span>
      </a>
      <p class="footer-mission-text">
        An educational reference and cultural dictionary dedicated to authentic Korean names, Sino-Korean Hanja characters, ancestral clan lineages, and traditional naming culture.
      </p>
      <div class="footer-source-note">
        <strong>Data Sources:</strong> Modeled on the Supreme Court of Korea Registry of Approved Hanja (대법원 인명용 한자표) and Revised Romanization standards.
      </div>
    </div>

    <!-- Column 2: Name Directories -->
    <div class="footer-col">
      <h3 class="footer-heading">Korean Given Names</h3>
      <ul class="footer-links">
        <li><a href="/gender/girl">Korean Girl Names (여성 이름)</a></li>
        <li><a href="/gender/boy">Korean Boy Names (남성 이름)</a></li>
        <li><a href="/gender/unisex">Unisex Korean Names (중성 이름)</a></li>
        <li><a href="/letter/a">A–Z Alphabetical Directory</a></li>
        <li><a href="/theme/nature">Nature & Earth Names</a></li>
        <li><a href="/theme/wisdom">Wisdom & Intellect Names</a></li>
        <li><a href="/theme/grace">Grace & Elegance Names</a></li>
      </ul>
    </div>

    <!-- Column 3: Surnames & Hanja -->
    <div class="footer-col">
      <h3 class="footer-heading">Surnames & Hanja</h3>
      <ul class="footer-links">
        <li><a href="/surname">Korean Surnames Directory (성씨)</a></li>
        <li><a href="/surname/kim">Kim (김) Clan Lineage</a></li>
        <li><a href="/surname/lee">Lee (이) Clan Lineage</a></li>
        <li><a href="/surname/park">Park (박) Clan Lineage</a></li>
        <li><a href="/hanja">Sino-Korean Hanja Dictionary (漢字)</a></li>
        <li><a href="/tools/name-generator">Korean Name Generator</a></li>
        <li><a href="/tools/favorite-names">Saved Favorite Names</a></li>
      </ul>
    </div>

    <!-- Column 4: Editorial & Standards -->
    <div class="footer-col">
      <h3 class="footer-heading">About & Standards</h3>
      <ul class="footer-links">
        <li><a href="/guides">Educational Naming Guides</a></li>
        <li><a href="/author">Editorial Standards & Methodology</a></li>
        <li><a href="/acknowledgments">Linguistic & Cultural Citations</a></li>
        <li><a href="/contact">Contact Editorial Team</a></li>
        <li><a href="/sitemap">HTML Site Directory</a></li>
        <li><a href="/sitemap.xml" target="_blank" rel="noopener">XML Sitemap</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Service</a></li>
      </ul>
    </div>

  </div>

  <!-- Bottom Copyright & Compliance Bar -->
  <div class="footer-bottom-bar">
    <div class="container footer-bottom-inner">
      <p class="copyright-text">
        &copy; {currentYear} KoreanNames.info. All rights reserved. Content provided for educational, genealogical, and cultural reference.
      </p>
      <div class="footer-bottom-badges">
        <span class="badge-tag">Hanja Registry Reference</span>
        <span class="badge-tag">Revised Romanization (RR)</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .editorial-footer {
    background-color: var(--bg-footer);
    border-top: 1px solid var(--border-color);
    padding-top: 3.5rem;
    margin-top: 4.5rem;
    font-size: 0.875rem;
  }

  .footer-content-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .brand-col {
    padding-right: 1rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--brand-teal);
    background: var(--brand-teal-light);
  }

  .footer-brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
  }

  .footer-mission-text {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .footer-source-note {
    font-size: 0.775rem;
    line-height: 1.5;
    padding: 0.75rem 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .footer-source-note strong {
    color: var(--brand-teal-deep);
  }

  .footer-heading {
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--text-main);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 0.85rem;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--brand-teal-deep);
    text-decoration: underline;
  }

  .footer-bottom-bar {
    background: var(--bg-footer-bottom);
    color: rgba(255, 255, 255, 0.85);
    padding: 1.25rem 0;
    font-size: 0.8rem;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright-text {
    margin: 0;
  }

  .footer-bottom-badges {
    display: flex;
    gap: 0.5rem;
  }

  .badge-tag {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xs);
    font-size: 0.7rem;
    color: white;
    letter-spacing: 0.02em;
  }

  @media (max-width: 960px) {
    .footer-content-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .footer-content-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
