---
const currentYear = new Date().getFullYear();
---

<footer class="editorial-footer">
  <div class="container footer-content-grid">
    
    <!-- Brand & Cultural Mission -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-brand" aria-label="KoreanNames.info Homepage">
        <img
          src="/logo.jpg"
          alt="KoreanNames.info Seal"
          width="42"
          height="42"
          class="footer-logo-img"
          loading="lazy"
        />
        <div class="brand-text">
          <span class="footer-brand-title">KoreanNames<span class="brand-tld">.info</span></span>
          <span class="footer-brand-sub">Digital Onomastic Encyclopedia</span>
        </div>
      </a>
      <p class="footer-mission-text">
        An authoritative, non-profit-oriented cultural dictionary and linguistic reference dedicated to Korean given names, ancestral clan surnames (*본관*), Sino-Korean Hanja characters, and naming traditions.
      </p>
      <div class="footer-source-note">
        <strong>Primary Citations:</strong> Supreme Court of Korea Registry of Hanja for Personal Names (*대법원 인명용 한자*) and National Institute of Korean Language (*국립국어원*) phonological standards.
      </div>
    </div>

    <!-- Column 1: Explore Names -->
    <div class="footer-col">
      <h3 class="footer-heading">Explore Names</h3>
      <ul class="footer-links">
        <li><a href="/names">All Korean Names</a></li>
        <li><a href="/girl-names">Korean Girl Names (여성)</a></li>
        <li><a href="/boy-names">Korean Boy Names (남성)</a></li>
        <li><a href="/unisex-names">Korean Unisex Names (중성)</a></li>
        <li><a href="/names/meaning">Names by Meaning (의미별)</a></li>
        <li><a href="/names/letter/a">A–Z Alphabetical Index</a></li>
      </ul>
    </div>

    <!-- Column 2: Reference & Interactive Tools -->
    <div class="footer-col">
      <h3 class="footer-heading">Reference & Tools</h3>
      <ul class="footer-links">
        <li><a href="/surnames">Korean Surnames & Clans (성씨)</a></li>
        <li><a href="/hanja">Sino-Korean Hanja Dictionary (漢字)</a></li>
        <li><a href="/name-generator">Korean Name Generator</a></li>
        <li><a href="/name-finder">Korean Name Finder</a></li>
        <li><a href="/name-comparison">Compare Korean Names</a></li>
        <li><a href="/certificate">Name Certificate Generator</a></li>
        <li><a href="/favorites">Saved Favorites Shortlist</a></li>
      </ul>
    </div>

    <!-- Column 3: Learn & Authority -->
    <div class="footer-col">
      <h3 class="footer-heading">Learn & Authority</h3>
      <ul class="footer-links">
        <li><a href="/learn">Knowledge Centre Hub</a></li>
        <li><a href="/learn/how-korean-names-work">Anatomy of a Korean Name</a></li>
        <li><a href="/learn/hangul-vs-hanja">Hangul vs. Hanja Logograms</a></li>
        <li><a href="/learn/pure-korean-names">Pure Korean (Soon-woori-mal)</a></li>
        <li><a href="/learn/korean-surnames-and-clans">Surnames & Bon-gwan Clans</a></li>
        <li><a href="/learn/korean-pronunciation-guide">Pronunciation & Romanization</a></li>
        <li><a href="/methodology">Research Methodology</a></li>
        <li><a href="/sources">Authoritative Sources</a></li>
      </ul>
    </div>

    <!-- Column 4: About & Governance -->
    <div class="footer-col">
      <h3 class="footer-heading">About & Legal</h3>
      <ul class="footer-links">
        <li><a href="/about">About KoreanNames.info</a></li>
        <li><a href="/author">Editorial Board & Standards</a></li>
        <li><a href="/contact">Contact Editorial Team</a></li>
        <li><a href="/admin">Database Administration</a></li>
        <li><a href="/sitemap">HTML Site Directory</a></li>
        <li><a href="/sitemap.xml" target="_blank" rel="noopener">XML Sitemap</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Service</a></li>
      </ul>
    </div>

  </div>

  <!-- Bottom Bar: Midnight Navy -->
  <div class="footer-bottom-bar">
    <div class="container footer-bottom-inner">
      <p class="copyright-text">
        &copy; {currentYear} KoreanNames.info. All rights reserved. Built for cultural education, genealogical study, and linguistic reference.
      </p>
      <div class="footer-bottom-badges">
        <span class="badge-tag">대법원 인명용 한자</span>
        <span class="badge-tag">국립국어원 표준</span>
        <span class="badge-tag">Revised Romanization</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .editorial-footer {
    background-color: var(--bg-surface-warm);
    border-top: 1px solid var(--border-color);
    padding-top: 4rem;
    margin-top: 5rem;
    font-size: 0.875rem;
  }

  .footer-content-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 3.5rem;
  }

  .brand-col {
    padding-right: 1.5rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.15rem;
  }

  .footer-logo-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-gold);
    box-shadow: var(--shadow-sm);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .footer-brand-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.02em;
  }

  .brand-tld {
    color: var(--color-gold);
  }

  .footer-brand-sub {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  .footer-mission-text {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 1.25rem;
  }

  .footer-source-note {
    font-size: 0.8rem;
    line-height: 1.55;
    padding: 0.85rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--color-jade);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .footer-source-note strong {
    color: var(--color-jade);
  }

  .footer-heading {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--text-heading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.15rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--color-gold-surface);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 0.85rem;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--color-jade);
    transform: translateX(2px);
    text-decoration: none;
  }

  /* Bottom Compliance Bar: Midnight Navy */
  .footer-bottom-bar {
    background-color: var(--color-navy);
    color: rgba(255, 255, 255, 0.85);
    padding: 1.35rem 0;
    font-size: 0.8125rem;
    border-top: 2px solid var(--color-gold);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright-text {
    margin: 0;
  }

  .footer-bottom-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-tag {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-xs);
    font-size: 0.725rem;
    color: #FFFFFF;
    letter-spacing: 0.02em;
  }

  @media (max-width: 1100px) {
    .footer-content-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .brand-col {
      grid-column: 1 / -1;
      padding-right: 0;
    }
  }

  @media (max-width: 680px) {
    .footer-content-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
  }
</style>
