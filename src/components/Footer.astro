---
const currentYear = new Date().getFullYear();
---

<footer class="bump-footer">
  <div class="container footer-content-grid">
    
    <!-- Column 1: Brand & Mission -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-brand" aria-label="KoreanNames.info Homepage">
        <img
          src="/logo.jpg"
          alt="KoreanNames.info Logo"
          width="38"
          height="38"
          class="footer-logo-img"
          loading="lazy"
        />
        <div class="brand-text">
          <span class="footer-brand-title">KoreanNames<span class="brand-tld">.info</span></span>
          <span class="footer-brand-sub">Korean Naming Dictionary</span>
        </div>
      </a>
      <p class="footer-mission-text">
        An authentic cultural and linguistic reference dedicated to Korean given names, family surnames, Sino-Korean Hanja characters, and naming traditions.
      </p>
      <div class="footer-social-strip">
        <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="footer-icon-btn" aria-label="Facebook">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="footer-icon-btn" aria-label="X">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="mailto:contact@korean-names.info" class="footer-icon-btn" aria-label="Email">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Column 2: Explore Names & Categories -->
    <div class="footer-col">
      <h3 class="footer-heading">Explore Names</h3>
      <ul class="footer-links">
        <li><a href="/names">All Korean Names</a></li>
        <li><a href="/girl-names">Korean Girl Names</a></li>
        <li><a href="/boy-names">Korean Boy Names</a></li>
        <li><a href="/unisex-names">Korean Unisex Names</a></li>
        <li><a href="/names/meaning">Names by Meaning</a></li>
        <li><a href="/names/letter/a">A–Z Alphabetical Index</a></li>
        <li><a href="/favorites">Saved Favorites</a></li>
      </ul>
    </div>

    <!-- Column 3: Reference & Tools -->
    <div class="footer-col">
      <h3 class="footer-heading">Reference & Tools</h3>
      <ul class="footer-links">
        <li><a href="/surnames">Korean Surnames (성씨)</a></li>
        <li><a href="/hanja">Hanja Character Dictionary</a></li>
        <li><a href="/name-generator">Name Generator & Surname Pairing</a></li>
        <li><a href="/name-finder">Korean Name Finder</a></li>
        <li><a href="/name-comparison">Compare Names</a></li>
      </ul>
    </div>

    <!-- Column 4: Learn & About -->
    <div class="footer-col">
      <h3 class="footer-heading">Learn & About</h3>
      <ul class="footer-links">
        <li><a href="/learn">Knowledge Center</a></li>
        <li><a href="/guides/how-korean-names-work">How Korean Names Work</a></li>
        <li><a href="/guides/hangul-vs-hanja">Hangul vs. Hanja Logograms</a></li>
        <li><a href="/guides/pure-korean-names">Pure Korean Names</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Service</a></li>
      </ul>
    </div>

  </div>

  <!-- Bottom Bar: Minimal Muted Navy -->
  <div class="footer-bottom-bar">
    <div class="container footer-bottom-inner">
      <p class="copyright-text">
        &copy; {currentYear} KoreanNames.info. All rights reserved. Built for cultural education and linguistic reference.
      </p>
      <div class="footer-legal-links">
        <a href="/privacy">Privacy</a>
        <span class="legal-dot">·</span>
        <a href="/terms">Terms</a>
        <span class="legal-dot">·</span>
        <a href="/about">About</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Minimal Muted Navy Footer (The Bump Style) */
  .bump-footer {
    background-color: #24334A;
    color: #E2E8F0;
    padding-top: 3.5rem;
    margin-top: 5rem;
    font-size: 0.875rem;
    border-top: 1px solid #1E2B3E;
  }

  .footer-content-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .brand-col {
    padding-right: 1.5rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    text-decoration: none;
  }

  .footer-logo-img {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .footer-brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
  }

  .brand-tld {
    color: #6EE7B7;
  }

  .footer-brand-sub {
    font-size: 0.675rem;
    font-weight: 600;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  .footer-mission-text {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin-bottom: 1.25rem;
  }

  .footer-social-strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #CBD5E1;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .footer-icon-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .footer-heading {
    font-size: 0.85rem;
    font-weight: 800;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0;
    margin: 0;
  }

  .footer-links a {
    color: #94A3B8;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #FFFFFF;
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    background-color: #1A2536;
    color: #94A3B8;
    padding: 1.25rem 0;
    font-size: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright-text {
    margin: 0;
    color: #94A3B8;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-legal-links a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-legal-links a:hover {
    color: #FFFFFF;
  }

  .legal-dot {
    color: #64748B;
  }

  @media (max-width: 900px) {
    .footer-content-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand-col {
      grid-column: 1 / -1;
      padding-right: 0;
    }
  }

  @media (max-width: 600px) {
    .footer-content-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
