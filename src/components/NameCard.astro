---
import type { KoreanName } from '../types/name';
import AudioPlayer from './AudioPlayer.astro';
import BookmarkButton from './BookmarkButton.astro';

export interface Props {
  name: KoreanName;
}

const { name } = Astro.props;

const genderBadgeClass = name.gender === 'boy' ? 'badge-boy' : name.gender === 'girl' ? 'badge-girl' : 'badge-unisex';
const genderLabel = name.gender === 'boy' ? 'Boy Name' : name.gender === 'girl' ? 'Girl Name' : 'Unisex Name';
---

<article class="name-card editorial-card">
  <!-- Card Header -->
  <div class="card-top">
    <div class="badge-group">
      <span class={`badge ${genderBadgeClass}`}>{genderLabel}</span>
      {name.isTrending && name.popularityRank && name.popularityRank <= 20 && (
        <span class="badge badge-gold">Top {name.popularityRank}</span>
      )}
    </div>
    <BookmarkButton slug={name.slug} nameEnglish={name.english} size="sm" />
  </div>

  <!-- Primary Name Presentation -->
  <a href={`/name/${name.slug}`} class="name-main-anchor">
    <div class="korean-char-display">
      <span class="hangul-lead">{name.hangul}</span>
      {name.hanja && <span class="hanja-sub">({name.hanja})</span>}
    </div>
    <h3 class="english-title">{name.english}</h3>
  </a>

  <!-- Syllable Breakdown Preview -->
  {name.syllables && name.syllables.length > 0 && (
    <div class="syllable-preview-grid">
      {name.syllables.map((s) => (
        <div class="syllable-item">
          <div class="syl-char">
            <span class="syl-hangul">{s.hangul}</span>
            <span class="syl-hanja">{s.hanja}</span>
          </div>
          <span class="syl-meaning" title={s.meaning}>{s.meaning}</span>
        </div>
      ))}
    </div>
  )}

  <!-- Overall Meaning -->
  <p class="overall-meaning-text">
    {name.overallMeaning}
  </p>

  <!-- Card Action Footer -->
  <div class="card-bottom">
    <AudioPlayer text={name.hangul} size="sm" label="Pronounce" />
    <a href={`/name/${name.slug}`} class="view-detail-btn" aria-label={`View full details for ${name.english}`}>
      <span>Details</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>

<style>
  .name-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-xs);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .name-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--brand-teal);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .badge-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .name-main-anchor {
    display: block;
    margin-bottom: 0.75rem;
    text-decoration: none;
  }

  .korean-char-display {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .hangul-lead {
    font-family: var(--font-korean);
    font-size: 1.85rem;
    font-weight: 900;
    color: var(--text-main);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .hanja-sub {
    font-family: var(--font-korean);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent-indigo);
  }

  .english-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    margin-top: 0.2rem;
    line-height: 1.25;
  }

  .syllable-preview-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    padding: 0.6rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    margin-bottom: 0.75rem;
  }

  .syllable-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .syl-char {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .syl-hangul {
    font-family: var(--font-hangul);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .syl-hanja {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .syl-meaning {
    font-size: 0.725rem;
    color: var(--text-muted);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .overall-meaning-text {
    font-size: 0.825rem;
    color: var(--text-body);
    line-height: 1.45;
    margin-bottom: 1rem;
    flex: 1 0 auto;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .view-detail-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    transition: gap 0.15s ease, color 0.15s ease;
  }

  .view-detail-btn:hover {
    color: var(--brand-teal);
    gap: 0.4rem;
  }
</style>
