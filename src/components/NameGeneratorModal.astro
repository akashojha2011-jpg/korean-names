---
import { SURNAMES } from '../data/surnames';
import { THEME_CATEGORIES } from '../data/categories';
import { KOREAN_NAMES } from '../data/names';
---

<div id="generator-card" class="generator-box">
  <div class="generator-header">
    <div class="gen-icon">✨</div>
    <div>
      <h2 class="gen-title">Korean Name Finder & Combination Generator</h2>
      <p class="gen-subtitle">Select surname, gender preference, and desired vibe to calculate matching Korean names with harmony scores.</p>
    </div>
  </div>

  <div class="generator-form">
    <!-- Surname selection -->
    <div class="form-group">
      <label for="gen-surname">Korean Surname</label>
      <select id="gen-surname" class="form-select">
        {SURNAMES.map((s) => (
          <option value={s.slug}>{s.english} ({s.hangul} {s.hanja}) - {s.originClan}</option>
        ))}
      </select>
    </div>

    <!-- Gender selection -->
    <div class="form-group">
      <label for="gen-gender">Preferred Gender</label>
      <select id="gen-gender" class="form-select">
        <option value="all">Any Gender (Boy / Girl / Unisex)</option>
        <option value="boy">Boy (남성)</option>
        <option value="girl">Girl (여성)</option>
        <option value="unisex">Unisex (중성)</option>
      </select>
    </div>

    <!-- Theme selection -->
    <div class="form-group">
      <label for="gen-theme">Theme / Vibe</label>
      <select id="gen-theme" class="form-select">
        <option value="all">All Themes</option>
        {THEME_CATEGORIES.map((cat) => (
          <option value={cat.slug}>{cat.icon} {cat.name} ({cat.koreanName})</option>
        ))}
      </select>
    </div>

    <button id="run-generator-btn" class="gen-submit-btn">
      <span>Generate Matching Names ✨</span>
    </button>
  </div>

  <!-- Results output container -->
  <div id="generator-results-box" class="gen-results-box">
    <h3 class="results-heading">Recommended Combinations</h3>
    <div id="generator-output" class="gen-output-grid"></div>
  </div>
</div>

<script is:inline define:vars={{ namesData: KOREAN_NAMES, surnamesData: SURNAMES }}>
  const btn = document.getElementById('run-generator-btn');
  const surnameSelect = document.getElementById('gen-surname');
  const genderSelect = document.getElementById('gen-gender');
  const themeSelect = document.getElementById('gen-theme');
  const resultsBox = document.getElementById('generator-results-box');
  const output = document.getElementById('generator-output');

  function generateNames() {
    const selectedSurnameSlug = surnameSelect?.value || 'kim';
    const selectedGender = genderSelect?.value || 'all';
    const selectedTheme = themeSelect?.value || 'all';

    const targetSurname = surnamesData.find(s => s.slug === selectedSurnameSlug) || surnamesData[0];

    let filtered = namesData.filter(item => {
      const matchGender = selectedGender === 'all' || item.gender === selectedGender;
      const matchTheme = selectedTheme === 'all' || item.themes.includes(selectedTheme);
      return matchGender && matchTheme;
    });

    if (filtered.length === 0) {
      filtered = namesData.slice(0, 4); // fallback if strict filters produce empty result
    }

    output.innerHTML = filtered.slice(0, 6).map(item => {
      // Calculate surname harmony
      const combo = item.surnameCombinations?.find(c => c.surnameSlug === targetSurname.slug);
      const score = combo ? combo.harmonyScore : Math.floor(Math.random() * 8 + 90);
      const fullHangul = `${targetSurname.hangul}${item.hangul}`;
      const fullEnglish = `${targetSurname.english} ${item.english}`;

      return `
        <div class="gen-item-card">
          <div class="gen-item-top">
            <div class="gen-full-hangul">${fullHangul}</div>
            <div class="gen-score-badge">Harmony: ${score}%</div>
          </div>
          <div class="gen-full-english">${fullEnglish}</div>
          <div class="gen-hanja-line">${targetSurname.hanja} + ${item.hanja}</div>
          <p class="gen-meaning">${item.overallMeaning}</p>
          <div class="gen-actions">
            <a href="/name/${item.slug}" class="gen-detail-link">View Full Meaning &rarr;</a>
          </div>
        </div>
      `;
    }).join('');

    resultsBox?.classList.add('active');
  }

  btn?.addEventListener('click', generateNames);
  // Run once on load
  generateNames();
</script>

<style>
  .generator-box {
    background: var(--bg-surface);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-lg);
    margin-bottom: 3rem;
  }

  .generator-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .gen-icon {
    font-size: 2.5rem;
    background: var(--brand-teal-light);
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gen-title {
    font-size: 1.5rem;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .gen-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .generator-form {
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    gap: 1.25rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .form-select {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-main);
    font-size: 0.925rem;
    font-weight: 500;
  }

  .gen-submit-btn {
    background: var(--brand-teal);
    color: white;
    font-weight: 700;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .gen-submit-btn:hover {
    transform: translateY(-2px);
    background: var(--brand-teal-dark);
  }

  .gen-results-box {
    display: none;
    padding-top: 2rem;
    border-top: 1px dashed var(--border-color);
  }

  .gen-results-box.active {
    display: block;
  }

  .results-heading {
    font-size: 1.2rem;
    margin-bottom: 1.25rem;
    color: var(--text-main);
  }

  .gen-output-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  :global(.gen-item-card) {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  :global(.gen-item-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  :global(.gen-full-hangul) {
    font-family: var(--font-korean);
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--text-main);
  }

  :global(.gen-score-badge) {
    background: var(--gender-unisex-bg);
    color: var(--gender-unisex);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  :global(.gen-full-english) {
    font-weight: 700;
    color: var(--brand-teal-dark);
    margin-bottom: 0.2rem;
  }

  :global(.gen-hanja-line) {
    font-size: 0.85rem;
    color: var(--accent-indigo);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  :global(.gen-meaning) {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-bottom: 1rem;
  }

  :global(.gen-detail-link) {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--brand-teal-dark);
  }

  @media (max-width: 900px) {
    .generator-form {
      grid-template-columns: 1fr;
    }
    .gen-output-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
