<script>
  // Theme Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  const iconSun = themeToggleBtn?.querySelector('.icon-sun') as HTMLElement;
  const iconMoon = themeToggleBtn?.querySelector('.icon-moon') as HTMLElement;

  function applyTheme(theme: string) {
    const isDark = theme === 'dark';
    document.documentElement.setAttribute('data-theme', theme);
    if (isDark) {
      document.body.classList.add('dark-mode');
      if (iconSun) iconSun.style.display = 'block';
      if (iconMoon) iconMoon.style.display = 'none';
    } else {
      document.body.classList.remove('dark-mode');
      if (iconSun) iconSun.style.display = 'none';
      if (iconMoon) iconMoon.style.display = 'block';
    }
  }

  const savedTheme = localStorage.getItem('kn-theme') || 
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  applyTheme(savedTheme);

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.body.classList.contains('dark-mode');
    const newTheme = isDark ? 'light' : 'dark';
    localStorage.setItem('kn-theme', newTheme);
    applyTheme(newTheme);
  });

  // Favorites Badge Count
  function updateNavFavCount() {
    try {
      const modern = JSON.parse(localStorage.getItem('korean_name_favorites') || '[]');
      const legacy = JSON.parse(localStorage.getItem('hanname-saved-names') || '[]');
      const count = modern.length > 0 ? modern.length : legacy.length;
      const countPill = document.getElementById('nav-fav-count');
      const mobileCount = document.getElementById('mobile-fav-count');
      const drawerCount = document.getElementById('drawer-fav-count');

      [countPill, mobileCount].forEach(pill => {
        if (pill) {
          if (count > 0) {
            pill.textContent = String(count);
            pill.style.display = 'inline-flex';
          } else {
            pill.style.display = 'none';
          }
        }
      });

      if (drawerCount) {
        drawerCount.textContent = String(count);
      }
    } catch (e) {
      // Storage unavailable
    }
  }

  updateNavFavCount();
  window.addEventListener('storage', updateNavFavCount);
  window.addEventListener('favoritesUpdated', updateNavFavCount);

  // Global hotkey '/' to focus search
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) {
      e.preventDefault();
      window.location.href = '/names';
    }
  });

  // Mobile Drawer Toggle Logic
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menuClose = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-nav-drawer');
  const backdrop = document.getElementById('mobile-nav-backdrop');

  function openDrawer() {
    drawer?.classList.add('open');
    backdrop?.classList.add('open');
    menuToggle?.setAttribute('aria-expanded', 'true');
    drawer?.setAttribute('aria-hidden', 'false');
    backdrop?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    backdrop?.classList.remove('open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    drawer?.setAttribute('aria-hidden', 'true');
    backdrop?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', openDrawer);
  menuClose?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) {
      closeDrawer();
    }
  });
</script>

<style>
  /* Main Navigation Header: Crisp Minimal White (Bump Style) */
  .main-navbar {
    width: 100%;
    background-color: var(--bg-surface);
    color: var(--text-main);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 900;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    gap: 1.25rem;
  }

  .brand-wrapper {
    flex-shrink: 0;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand-logo-img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-color);
    flex-shrink: 0;
  }

  .brand-text-group {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-heading);
    font-family: var(--font-sans);
  }

  .brand-tld {
    color: var(--color-jade);
  }

  .brand-subtitle {
    font-size: 0.675rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-top: 0.1rem;
  }

  /* Header Search Pill (Compact, Clean) */
  .header-search-wrap {
    flex-shrink: 1;
    max-width: 220px;
    width: 100%;
  }

  .header-search-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    background: var(--bg-surface-muted);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: 0.8rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .header-search-pill:hover {
    background: var(--bg-surface-warm);
    border-color: var(--color-jade-border);
    color: var(--text-main);
  }

  .header-search-pill span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-kbd {
    display: inline-block;
    padding: 0.1rem 0.35rem;
    font-size: 0.65rem;
    font-family: inherit;
    font-weight: 700;
    background: var(--border-color);
    color: var(--text-main);
    border-radius: var(--radius-xs);
    line-height: 1;
  }

  /* Primary Navigation Tabs (Desktop) */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.65rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-body);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    text-decoration: none;
    transition: all 0.15s ease;
    border-bottom: 2px solid transparent;
  }

  .nav-item:hover {
    color: var(--color-jade);
    background: var(--bg-surface-warm);
  }

  .nav-item.active {
    color: var(--color-jade);
    border-bottom-color: var(--color-jade);
    font-weight: 700;
    background: transparent;
  }

  /* Desktop Right Utility: Favorites & Theme */
  .header-right-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .header-shortlist-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--bg-surface-warm);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .header-shortlist-btn:hover {
    border-color: var(--color-burgundy);
    color: var(--color-burgundy);
  }

  .header-shortlist-btn svg {
    color: var(--color-burgundy);
  }

  .fav-count-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    background: var(--color-burgundy);
    color: white;
    font-size: 0.65rem;
    font-weight: 800;
    border-radius: var(--radius-full);
  }

  .header-theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    background: var(--bg-surface-warm);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .header-theme-btn:hover {
    background: var(--bg-surface-muted);
  }

  /* Mobile Actions (< 1024px) */
  .mobile-header-actions {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--bg-surface-warm);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .mobile-icon-btn:hover {
    background: var(--bg-surface-muted);
  }

  .fav-mobile-btn svg {
    color: var(--color-burgundy);
  }

  .fav-mobile-btn .fav-count-pill {
    position: absolute;
    top: -2px;
    right: -2px;
  }

  .mobile-menu-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    padding: 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-surface-warm);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .mobile-menu-btn:hover {
    background: var(--bg-surface-muted);
  }

  .hamburger-bar {
    width: 18px;
    height: 2px;
    background-color: var(--text-main);
    border-radius: 2px;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1240px) {
    .header-search-wrap {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .nav-links,
    .header-right-actions {
      display: none;
    }

    .mobile-header-actions {
      display: inline-flex;
    }

    .header-inner {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
  }

  @media (max-width: 600px) {
    .brand-title {
      font-size: 1.15rem;
    }
    .brand-subtitle {
      font-size: 0.58rem;
    }
    .brand-logo-img {
      width: 32px;
      height: 32px;
    }
  }

  /* Mobile Drawer Overlay */
  .mobile-nav-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .mobile-nav-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 300px;
    max-width: 85vw;
    height: 100vh;
    background: var(--bg-surface);
    border-left: 1px solid var(--border-color);
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
    z-index: 999;
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .mobile-nav-drawer.open {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-surface-warm);
  }

  .drawer-brand {
