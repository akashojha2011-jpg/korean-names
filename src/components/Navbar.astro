---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  if (path === '/names') return pathname === '/names' || (pathname.startsWith('/names/') && !pathname.startsWith('/names/meaning'));
  if (path === '/names/meaning') return pathname.startsWith('/names/meaning') || pathname.startsWith('/theme/');
  if (path === '/surnames') return pathname.startsWith('/surname');
  if (path === '/learn') return pathname.startsWith('/learn') || pathname.startsWith('/guides');
  if (path === '/hanja') return pathname.startsWith('/hanja');
  if (path === '/name-generator') return pathname.startsWith('/name-generator') || pathname.startsWith('/tools/name-generator');
  if (path === '/about') return pathname === '/about' || pathname === '/author' || pathname === '/contact';
  return pathname.startsWith(path);
};
