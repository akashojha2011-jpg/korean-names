    width: 100%;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    padding: 0.35rem 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .utility-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cultural-emblem {
    font-size: 0.95rem;
  }

  .utility-text {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .utility-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .utility-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
    background: var(--bg-primary);
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--text-body);
    transition: all 0.15s ease;
  }

  .utility-btn:hover {
    border-color: var(--brand-teal);
    color: var(--brand-teal-deep);
  }

  .fav-count-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    background: var(--brand-teal);
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
    border-radius: var(--radius-full);
  }

  .theme-btn {
    padding: 0.25rem 0.45rem;
    width: 28px;
    height: 28px;
    justify-content: center;
  }

  /* Main Navigation Header */
  .main-navbar {
    width: 100%;
    background: var(--brand-teal);
    color: white;
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    gap: 1.5rem;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: white;
  }

  .brand-logo-img {
    width: 44px;
