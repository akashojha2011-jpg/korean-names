  @media (max-width: 900px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding-top: 0.65rem;
      padding-bottom: 0.65rem;
    }

    .nav-links {
      width: 100%;
      padding-bottom: 0.25rem;
    }

    .utility-text {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 600px) {
    .utility-left {
      display: none;
    }
    .utility-inner {
      justify-content: flex-end;
    }
  }
</style>
