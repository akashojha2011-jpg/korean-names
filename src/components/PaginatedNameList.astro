---
import type { KoreanName } from '../types/name';
import NameRowItem from './NameRowItem.astro';

export interface Props {
  names: KoreanName[];
  pageSize?: number;
}

const { names, pageSize = 25 } = Astro.props;
const totalPages = Math.ceil(names.length / pageSize);
---

<div class="paginated-list-wrapper">
  <!-- Name Rows Container -->
  <div id="paginated-list-container" class="name-rows-container">
    {names.map((name, index) => {
      const pageNum = Math.floor(index / pageSize) + 1;
      return (
        <div class="paginated-item" data-page={pageNum} style={pageNum > 1 ? 'display: none;' : ''}>
          <NameRowItem name={name} />
        </div>
      );
    })}
  </div>

  <!-- Numbered Pagination Controls -->
  {totalPages > 1 && (
    <nav class="pagination-controls" aria-label="Directory pagination">
      <button id="pg-prev-btn" class="pg-btn" disabled aria-label="Previous Page">&larr; Previous</button>
      <div id="pg-numbers-box" class="pg-numbers-box">
        {Array.from({ length: Math.min(totalPages, 8) }, (_, i) => i + 1).map((p) => (
          <button class={`pg-num-btn ${p === 1 ? 'active' : ''}`} data-page-target={p} aria-label={`Go to page ${p}`}>
            {p}
          </button>
        ))}
        {totalPages > 8 && <span class="pg-ellipsis" aria-hidden="true">&hellip;</span>}
      </div>
      <button id="pg-next-btn" class="pg-btn" aria-label="Next Page">Next &rarr;</button>
    </nav>
  )}
</div>

<script is:inline define:vars={{ totalPagesCount: totalPages }}>
  let currentPage = 1;
  const items = document.querySelectorAll('.paginated-item');
  const prevBtn = document.getElementById('pg-prev-btn');
  const nextBtn = document.getElementById('pg-next-btn');
  const numBtns = document.querySelectorAll('.pg-num-btn');

  function goToPage(page) {
    if (page < 1 || page > totalPagesCount) return;
    currentPage = page;

    items.forEach(item => {
      const itemPage = parseInt(item.getAttribute('data-page') || '1', 10);
      item.style.display = itemPage === currentPage ? 'block' : 'none';
    });

    numBtns.forEach(btn => {
      const targetPage = parseInt(btn.getAttribute('data-page-target') || '1', 10);
      btn.classList.toggle('active', targetPage === currentPage);
    });

    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = currentPage === totalPagesCount;

    document.getElementById('paginated-list-container')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  prevBtn?.addEventListener('click', () => goToPage(currentPage - 1));
  nextBtn?.addEventListener('click', () => goToPage(currentPage + 1));

  numBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = parseInt(e.currentTarget.getAttribute('data-page-target') || '1', 10);
      goToPage(target);
    });
  });
</script>

<style>
  .paginated-list-wrapper {
    width: 100%;
  }

  .name-rows-container {
    display: flex;
    flex-direction: column;
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-color);
  }

  .pg-btn {
    padding: 0.45rem 0.95rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--brand-teal-deep);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pg-btn:hover:not(:disabled) {
    background: var(--brand-teal);
    color: white;
    border-color: var(--brand-teal);
  }

  .pg-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pg-numbers-box {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pg-num-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    color: var(--text-body);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pg-num-btn:hover:not(.active) {
    border-color: var(--brand-teal);
    color: var(--brand-teal-deep);
  }

  .pg-num-btn.active {
    background: var(--brand-teal);
    color: white;
    border-color: var(--brand-teal);
  }

  .pg-ellipsis {
    color: var(--text-muted);
    font-weight: 700;
    padding: 0 0.25rem;
  }
</style>
