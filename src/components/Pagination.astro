---
export interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

function getPageUrl(page: number): string {
  if (page <= 1) return baseUrl;
  const separator = baseUrl.includes('?') ? '&' : '?';
  return `${baseUrl}${separator}page=${page}`;
}

// Build a reasonable array of page numbers with ellipsis
function getPageNumbers(current: number, total: number) {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const pages: (number | string)[] = [];
  pages.push(1);

  if (current > 3) {
    pages.push('...');
  }

  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }

  if (current < total - 2) {
    pages.push('...');
  }

  pages.push(total);
  return pages;
}

const pageNumbers = getPageNumbers(currentPage, totalPages);
---

{totalPages > 1 && (
  <nav class="editorial-pagination" aria-label="Pagination Navigation">
    <div class="pagination-list">
      <!-- Previous Button -->
      {currentPage > 1 ? (
        <a href={getPageUrl(currentPage - 1)} class="page-nav-link prev-link" rel="prev" aria-label="Previous page">
          &larr; Previous
        </a>
      ) : (
        <span class="page-nav-link disabled" aria-disabled="true">
          &larr; Previous
        </span>
      )}

      <!-- Page Numbers -->
      <div class="page-numbers-group">
        {pageNumbers.map((p) => {
          if (p === '...') {
            return <span class="page-ellipsis" aria-hidden="true">&hellip;</span>;
          }
          const isCurrent = p === currentPage;
          return isCurrent ? (
            <span class="page-number-item active" aria-current="page">
              {p}
            </span>
          ) : (
            <a href={getPageUrl(Number(p))} class="page-number-item" aria-label={`Go to page ${p}`}>
              {p}
            </a>
          );
        })}
      </div>

      <!-- Next Button -->
      {currentPage < totalPages ? (
        <a href={getPageUrl(currentPage + 1)} class="page-nav-link next-link" rel="next" aria-label="Next page">
          Next &rarr;
        </a>
      ) : (
        <span class="page-nav-link disabled" aria-disabled="true">
          Next &rarr;
        </span>
      )}
    </div>
  </nav>
)}

<style>
  .editorial-pagination {
    margin-top: 2.5rem;
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .pagination-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .page-nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand-teal-deep);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .page-nav-link:hover:not(.disabled) {
    background: var(--brand-teal);
    color: white;
    border-color: var(--brand-teal);
  }

  .page-nav-link.disabled {
    color: var(--text-light);
    background: var(--bg-secondary);
    border-color: var(--border-subtle);
    cursor: not-allowed;
  }

  .page-numbers-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .page-number-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-body);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .page-number-item:hover:not(.active) {
    border-color: var(--brand-teal);
    color: var(--brand-teal-deep);
  }

  .page-number-item.active {
    background: var(--brand-teal);
    color: white;
    border-color: var(--brand-teal);
    font-weight: 700;
  }

  .page-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    color: var(--text-muted);
    font-weight: 700;
  }
</style>
