---
---

<aside class="sidebar-container">
  <!-- Quick Tools Section -->
  <div class="sidebar-box">
    <div class="sidebar-header-teal">⚡ Quick Tools</div>
    <div class="sidebar-content">
      <div class="quick-links-list">
        <a href="/tools/name-generator" class="sidebar-tool-item">
          <span class="tool-icon">✨</span>
          <div class="tool-text">
            <strong class="tool-title">Name Generator</strong>
            <span class="tool-desc">Generate authentic Korean names</span>
          </div>
        </a>
        <a href="/tools/favorite-names" class="sidebar-tool-item">
          <span class="tool-icon">❤️</span>
          <div class="tool-text">
            <strong class="tool-title">My Favorites</strong>
            <span class="tool-desc">Saved favorite names</span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Popular Categories -->
  <div class="sidebar-box">
    <div class="sidebar-header-light">🏷️ Browse Categories</div>
    <div class="sidebar-content">
      <div class="cat-links-grid">
        <a href="/gender/girl" class="cat-chip chip-girl">🌸 Girl Names</a>
        <a href="/gender/boy" class="cat-chip chip-boy">👦 Boy Names</a>
        <a href="/gender/unisex" class="cat-chip chip-unisex">✳️ Unisex Names</a>
        <a href="/surname" class="cat-chip chip-surname">👑 Last Names</a>
        <a href="/hanja" class="cat-chip chip-hanja">🈩 Hanja Directory</a>
        <a href="/theme/royal" class="cat-chip chip-theme">👑 Royal Names</a>
        <a href="/theme/modern" class="cat-chip chip-theme">✨ Modern Names</a>
        <a href="/theme/k-pop" class="cat-chip chip-theme">🎵 K-Pop Names</a>
      </div>
    </div>
  </div>
</aside>

<style>
  .sidebar-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .sidebar-header-teal {
    background: #AEEAEA;
    color: #1F5A58;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 0.5rem 0.85rem;
  }

  :global([data-theme="dark"]) .sidebar-header-teal,
  :global(body.dark-mode) .sidebar-header-teal {
    background: #134E4A;
    color: #5EEAD4;
  }

  .sidebar-header-light {
    background: #E8F7F7;
    color: var(--brand-teal-dark);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.4rem 0.85rem;
    border-bottom: 1px solid var(--border-color);
  }

  :global([data-theme="dark"]) .sidebar-header-light,
  :global(body.dark-mode) .sidebar-header-light {
    background: rgba(45, 212, 191, 0.12);
    color: #2DD4BF;
    border-bottom-color: var(--border-color);
  }

  .sidebar-content {
    padding: 0.75rem;
  }

  .quick-links-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sidebar-tool-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem;
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .sidebar-tool-item:hover {
    transform: translateY(-1px);
    border-color: var(--brand-teal);
  }

  .tool-icon {
    font-size: 1.2rem;
  }

  .tool-text {
    display: flex;
    flex-direction: column;
  }

  .tool-title {
    font-size: 0.825rem;
    color: var(--text-main);
  }

  .tool-desc {
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  .cat-links-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cat-chip {
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    transition: all 0.15s ease;
  }

  .cat-chip:hover {
    background: var(--brand-teal);
    color: white;
    border-color: var(--brand-teal);
  }
</style>
