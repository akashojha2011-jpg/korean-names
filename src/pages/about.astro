---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About Us' }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': 'About Korean-Names.info - Editorial Mission & Cultural Standards',
  'url': 'https://www.korean-names.info/about',
  'description': 'Learn about Korean-Names.info: our editorial principles, linguistic verification methodology, and cultural mission to provide authoritative Korean nomenclature.'
};
---

<BaseLayout
  title="About Korean-Names.info - Editorial Mission & Linguistic Standards"
  description="Discover the mission behind Korean-Names.info. We provide verified Korean nomenclature, Hanja character definitions, and cultural educational resources based on statutory records."
  jsonLd={schema}
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="about-hero">
      <div class="heritage-tag">
        <span class="emblem font-hangul">기관 소개</span>
        <span>Editorial & Cultural Mission</span>
      </div>
      <h1 class="about-title">The Authoritative Reference for Korean Nomenclature</h1>
      <p class="about-subtitle">
        Korean-Names.info is a dedicated linguistic and cultural platform built to document, verify, and celebrate
        Korean personal nomenclature. We bridge ancient Confucian onomastics and modern statutory civil registries
        to provide accurate, trustworthy information for parents, scholars, and global learners.
      </p>
    </header>

    <!-- Mission & Pillars -->
    <div class="about-grid">
      <section class="editorial-card">
        <h2 class="card-heading">1. Our Cultural Mission</h2>
        <p>
          Korean names are not mere phonetic labels; they are carefully orchestrated works of literature, philosophy,
          and familial devotion. Every character reflects parental aspirations, cosmic balance, and ancestral lineage.
          Our goal is to eliminate inaccurate, automated mistranslations and provide a definitive encyclopedia that
          honors the true depth of Korean naming traditions.
        </p>
      </section>

      <section class="editorial-card">
        <h2 class="card-heading">2. Zero Synthetic or Fabricated Content</h2>
        <p>
          We maintain an uncompromising standard of research integrity:
        </p>
        <ul class="principles-list">
          <li><strong>No Made-Up Meanings:</strong> Every Hanja character definition conforms to canonical dictionaries and official Supreme Court guidelines.</li>
          <li><strong>No Arbitrary Statistics:</strong> Popularity ranks and demographic percentages are sourced from official birth registries and Statistics Korea census audits.</li>
          <li><strong>No Automated Placeholders:</strong> Name histories, clan origins (Bon-gwan), and phonetic notations are verified by editorial staff.</li>
        </ul>
      </section>

      <section class="editorial-card">
        <h2 class="card-heading">3. Dual-Layer Linguistic Precision</h2>
        <p>
          We accurately distinguish between:
        </p>
        <ul class="principles-list">
          <li><strong>Sino-Korean Names (한자어):</strong> Logographic names rooted in Chinese characters, where individual characters determine deep personal meanings and stroke balances.</li>
          <li><strong>Pure Native Korean Names (순우리말):</strong> Indigenous Korean nature and virtue words (like Haneul, Bada, and Areum) registered directly in phonetic Hangul without Hanja.</li>
        </ul>
      </section>

      <section class="editorial-card">
        <h2 class="card-heading">4. Institutional Data Sources</h2>
        <p>
          Our taxonomy is built directly upon the official statutory frameworks of the Republic of Korea:
        </p>
        <ul class="principles-list">
          <li><strong>Supreme Court of Korea (대법원):</strong> Table of Hanja for Personal Names (인명용 한자표).</li>
          <li><strong>National Institute of Korean Language (국립국어원):</strong> Standard Korean Dictionary and Revised Romanization rules.</li>
          <li><strong>Statistics Korea (통계청):</strong> National Population & Housing Census surname and clan seat statistics.</li>
        </ul>
      </section>
    </div>

    <!-- Quick Navigation to Standards -->
    <section class="standards-banner">
      <div class="standards-content">
        <h3 class="standards-title">Explore Our Editorial Documentation</h3>
        <p class="standards-text">
          Review our step-by-step verification methodology and inspect the full list of official statutory source documents.
        </p>
        <div class="standards-actions">
          <a href="/methodology" class="btn btn-primary">Research Methodology &rarr;</a>
          <a href="/sources" class="btn btn-secondary">Statutory Sources & Data Citations &rarr;</a>
          <a href="/learn" class="btn btn-secondary">Knowledge Centre &rarr;</a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  .about-hero {
    background: linear-gradient(135deg, var(--bg-surface) 0%, #EDE6D8 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 3.5rem 2.5rem;
    margin-bottom: 3rem;
    box-shadow: var(--shadow-sm);
  }

  .heritage-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-surface);
    border: 1px solid var(--antique-gold);
    color: var(--brand-jade);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .heritage-tag .emblem {
    color: var(--accent-burgundy);
    border-right: 1px solid var(--border-color);
    padding-right: 0.5rem;
  }

  .about-title {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
    margin-bottom: 1rem;
    max-width: 900px;
  }

  .about-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 820px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .editorial-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
  }

  .card-heading {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--brand-navy);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-color);
  }

  .editorial-card p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  .principles-list {
    padding-left: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-main);
  }

  .principles-list li {
    margin-bottom: 0.5rem;
  }

  .standards-banner {
    background: #FAF8F2;
    border: 1px solid var(--antique-gold);
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    text-align: center;
  }

  .standards-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--brand-navy);
    margin-bottom: 0.75rem;
  }

  .standards-text {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .standards-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
