---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Data Sources & Acknowledgments' }
];
---

<BaseLayout
  title="Data Sources & Linguistic Acknowledgments - KoreanNames.info"
  description="Academic, linguistic, and historical acknowledgments for Korean Hanja registries, Revised Romanization, and genealogical records."
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <main class="editorial-article-card">
      <header class="article-header">
        <span class="category-pill">Academic & Legal Sources</span>
        <h1 class="article-title">Acknowledgments & Cultural Citations</h1>
        <p class="article-meta">Linguistic and civil registry foundations for KoreanNames.info</p>
      </header>

      <section class="citation-block">
        <div class="citation-num">01</div>
        <div class="citation-content">
          <h2>Supreme Court of Korea Naming Registry (대한민국 대법원)</h2>
          <p>
            Our Hanja character entries and stroke counts are modeled on the official <strong>Registry of Approved Hanja for Human Names (대법원 인명용 한자표)</strong>. Under South Korean Family Register Law, names submitted for official birth registration must use characters from this approved national standard.
          </p>
        </div>
      </section>

      <section class="citation-block">
        <div class="citation-num">02</div>
        <div class="citation-content">
          <h2>National Institute of Korean Language (국립국어원)</h2>
          <p>
            Phonetic transcriptions, Hangul-to-English conversions, and spelling conventions adhere to the official <strong>Revised Romanization of Korean (국어의 로마자 표기법)</strong> standard promulgated by the Ministry of Culture, Sports and Tourism.
          </p>
        </div>
      </section>

      <section class="citation-block">
        <div class="citation-num">03</div>
        <div class="citation-content">
          <h2>Genealogical & Clan History Archives (본관과 족보)</h2>
          <p>
            Surname origin clan data (Bon-gwan 본관), royal founding ancestors (such as Bak Hyeokgeose of Silla or King Suro of Gaya), and clan lineages are compiled from historic Korean genealogical records (Jokbo 족보) and official national census reports from Statistics Korea (KOSIS).
          </p>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .editorial-article-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 3rem;
    max-width: 860px;
    margin: 0 auto;
    box-shadow: var(--shadow-xs);
    line-height: 1.7;
  }

  .article-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .category-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    background: var(--brand-teal-light);
    border: 1px solid var(--brand-teal-border);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .article-meta {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .citation-block {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  .citation-num {
    font-size: 2rem;
    font-weight: 900;
    color: var(--brand-teal);
    line-height: 1;
    opacity: 0.6;
  }

  .citation-content h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    margin-bottom: 0.5rem;
  }

  .citation-content p {
    font-size: 0.925rem;
    color: var(--text-body);
    margin: 0;
  }

  @media (max-width: 768px) {
    .editorial-article-card { padding: 1.75rem; }
    .citation-block { flex-direction: column; gap: 0.75rem; }
    .article-title { font-size: 1.75rem; }
  }
</style>
