---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Editorial Standards' }
];
---

<BaseLayout
  title="Editorial Standards & Research Methodology - KoreanNames.info"
  description="Learn about our data verification process, cultural citations, and onomastic standards for Korean names and Hanja characters."
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <main class="editorial-article-card">
      <header class="article-header">
        <span class="category-pill">Methodology & Transparency</span>
        <h1 class="article-title">Editorial Standards & Onomastic Methodology</h1>
        <p class="article-meta">Published for transparency in Korean cultural and linguistic reference</p>
      </header>

      <section class="article-section">
        <h2>Our Mission</h2>
        <p>
          <strong>KoreanNames.info</strong> is an independent educational dictionary and cultural reference resource dedicated to the study of Korean personal names (이름), ancestral family clans (성씨와 본관), and Sino-Korean logograms (인명용 한자).
        </p>
        <p>
          Our goal is to provide clear, linguistically accurate, and culturally grounded information for prospective parents, writers, genealogists, and Korean culture enthusiasts worldwide.
        </p>
      </section>

      <section class="article-section">
        <h2>Primary Data Sources & Legal Registries</h2>
        <p>
          To maintain rigorous factual integrity, all entries in our database are cross-referenced against authoritative primary resources:
        </p>
        <ul class="sources-list">
          <li>
            <strong>Supreme Court of South Korea (대한민국 대법원):</strong>
            Hanja characters and stroke counts are modeled on the official <em>Registry of Approved Hanja for Human Names (인명용 한자표)</em>, which governs permissible characters for South Korean birth certificate registration.
          </li>
          <li>
            <strong>National Institute of Korean Language (국립국어원):</strong>
            All phonetic transcriptions adhere strictly to the <em>Revised Romanization of Korean (국어의 로마자 표기법)</em>, enacted by the Ministry of Culture, Sports and Tourism (Decree No. 2000-8).
          </li>
          <li>
            <strong>National Census and Lineage Records:</strong>
            Surname population distribution and ancestral clan seats (Bon-gwan 본관) are verified against official Statistics Korea (KOSIS) census data and historical family genealogy archives.
          </li>
        </ul>
      </section>

      <section class="article-section">
        <h2>Distinction Between Verified Facts and Interpretations</h2>
        <p>
          A central rule of Korean naming is that <strong>pronunciation and meaning are distinct</strong>. Two Korean names that sound identical in spoken Hangul may carry completely different personal meanings depending on which Hanja logograms are selected.
        </p>
        <p>
          We do not invent popularity statistics, celebrity connections, or historical claims. When a name is a native "Pure Korean" word (순우리말) without Hanja characters (such as <em>Haneul</em> or <em>Bora</em>), we clearly identify it as such.
        </p>
      </section>

      <section class="article-section">
        <h2>Corrections & Community Inquiries</h2>
        <p>
          Linguistic accuracy is an ongoing commitment. If you notice a typo in a Hanja radical, an alternative regional pronunciation, or have an editorial suggestion, please contact our team via our <a href="/contact" class="inline-link">Contact Page</a>. We review all feedback with care.
        </p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .editorial-article-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 3rem;
    max-width: 860px;
    margin: 0 auto;
    box-shadow: var(--shadow-xs);
    line-height: 1.7;
  }

  .article-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .category-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    background: var(--brand-teal-light);
    border: 1px solid var(--brand-teal-border);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .article-meta {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .article-section {
    margin-bottom: 2.25rem;
  }

  .article-section h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    margin-bottom: 0.85rem;
  }

  .article-section p {
    font-size: 0.95rem;
    color: var(--text-body);
    margin-bottom: 1rem;
  }

  .sources-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
  }

  .sources-list li {
    padding: 1rem 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--text-body);
  }

  .sources-list strong {
    color: var(--text-main);
    display: block;
    margin-bottom: 0.25rem;
  }

  .inline-link {
    color: var(--brand-teal-deep);
    font-weight: 700;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .editorial-article-card { padding: 1.75rem; }
    .article-title { font-size: 1.75rem; }
  }
</style>
