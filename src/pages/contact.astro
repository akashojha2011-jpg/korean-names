---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us - KoreanNames.info"
  description="Get in touch with the KoreanNames.info editorial team for name inquiries, cultural corrections, or media partnerships."
>
  <div class="container page-wrapper">
    <nav class="comp-breadcrumbs">
      <a href="/">Home</a> &rsaquo;
      <span class="current">Contact Us</span>
    </nav>

    <main class="card legal-card">
      <h1 class="legal-title">Contact Our Editorial Team</h1>
      <p class="effective-date">We'd love to hear from you!</p>

      <div class="contact-grid">
        <form class="contact-form" onsubmit="event.preventDefault(); alert('Thank you for reaching out! Our editorial team will get back to you shortly.');">
          <div class="form-group">
            <label for="contact-name">Your Name</label>
            <input type="text" id="contact-name" class="form-input" required placeholder="Jane Doe" />
          </div>

          <div class="form-group">
            <label for="contact-email">Email Address</label>
            <input type="email" id="contact-email" class="form-input" required placeholder="jane@example.com" />
          </div>

          <div class="form-group">
            <label for="contact-subject">Inquiry Subject</label>
            <select id="contact-subject" class="form-input">
              <option value="suggestion">Baby Name Suggestion</option>
              <option value="correction">Linguistic Correction</option>
              <option value="media">Media / Partnership Inquiry</option>
              <option value="general">General Question</option>
            </select>
          </div>

          <div class="form-group">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" class="form-input text-area" rows="5" required placeholder="Write your message here..."></textarea>
          </div>

          <button type="submit" class="submit-contact-btn">Send Message ✨</button>
        </form>

        <div class="contact-sidebar-info">
          <h3>Editorial Office</h3>
          <p>📍 Gangnam-gu, Seoul, South Korea</p>
          <p>✉️ editor@korean-names.info</p>
          <p>⏱️ Response time: Within 24-48 business hours</p>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .page-wrapper { padding-top: 1rem; padding-bottom: 4rem; }
  .comp-breadcrumbs { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.25rem; display: flex; gap: 0.4rem; }
  .legal-card { padding: 3rem; max-width: 950px; margin: 0 auto; line-height: 1.7; }
  .legal-title { font-size: 2.2rem; margin-bottom: 0.25rem; color: var(--text-main); }
  .effective-date { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 2rem; border-bottom: 1px dashed var(--border-color); padding-bottom: 0.75rem; }
  .contact-grid { display: grid; grid-template-columns: 1fr 300px; gap: 2.5rem; }
  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.875rem; font-weight: 700; color: var(--text-main); }
  .form-input { padding: 0.75rem 1rem; border-radius: 4px; border: 1px solid var(--border-color); font-size: 0.925rem; }
  .text-area { resize: vertical; }
  .submit-contact-btn { background: var(--brand-teal-dark); color: white; font-weight: 700; padding: 0.85rem 1.5rem; border-radius: 4px; border: none; font-size: 0.95rem; }
  .submit-contact-btn:hover { background: var(--brand-teal); }
  .contact-sidebar-info { background: #F0FAF9; padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.9rem; }
  .contact-sidebar-info h3 { color: var(--brand-teal-dark); }
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
