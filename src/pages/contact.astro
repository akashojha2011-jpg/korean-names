---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact Us' }
];
---

<BaseLayout
  title="Contact the Editorial Team - KoreanNames.info"
  description="Send linguistic feedback, Korean name suggestions, or general inquiries to the KoreanNames.info editorial team."
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <main class="editorial-contact-card">
      <header class="contact-header">
        <span class="category-pill">Inquiries & Feedback</span>
        <h1 class="contact-title">Contact Our Editorial Team</h1>
        <p class="contact-sub">
          We welcome linguistic suggestions, cultural inquiries, and feedback from Korean speakers, scholars, and parents worldwide.
        </p>
      </header>

      <div class="contact-grid-layout">
        <!-- Contact Form -->
        <form class="contact-form" onsubmit="event.preventDefault(); alert('Thank you for your message! Our editorial team will review your inquiry.');">
          <div class="form-group">
            <label for="contact-name" class="form-label">Your Name</label>
            <input type="text" id="contact-name" class="form-input" required placeholder="e.g. Min-ji or Sarah" />
          </div>

          <div class="form-group">
            <label for="contact-email" class="form-label">Email Address</label>
            <input type="email" id="contact-email" class="form-input" required placeholder="your.email@example.com" />
          </div>

          <div class="form-group">
            <label for="contact-subject" class="form-label">Inquiry Topic</label>
            <select id="contact-subject" class="form-select">
              <option value="correction">Linguistic / Hanja Character Correction</option>
              <option value="suggestion">Korean Baby Name Addition</option>
              <option value="general">General Cultural Question</option>
              <option value="media">Media or Partnership Inquiry</option>
            </select>
          </div>

          <div class="form-group">
            <label for="contact-message" class="form-label">Your Message</label>
            <textarea id="contact-message" class="form-textarea" rows="5" required placeholder="Please provide details, citations, or character notes..."></textarea>
          </div>

          <button type="submit" class="submit-btn">
            <span>Send Message</span>
            <span aria-hidden="true">&rarr;</span>
          </button>
        </form>

        <!-- Sidebar Guidelines -->
        <aside class="contact-guidelines">
          <div class="guide-box">
            <h3 class="guide-box-title">Linguistic Suggestions</h3>
            <p class="guide-box-text">
              When suggesting a name or Hanja correction, please include the Hangul spelling, exact Hanja character (if applicable), and any relevant context from the Supreme Court registry.
            </p>
          </div>

          <div class="guide-box">
            <h3 class="guide-box-title">Response Time</h3>
            <p class="guide-box-text">
              Our editorial team strives to review and verify linguistic submissions within 2 to 3 business days.
            </p>
          </div>

          <div class="guide-box">
            <h3 class="guide-box-title">Editorial Standards</h3>
            <p class="guide-box-text">
              Review our <a href="/author" class="link-teal">Research Methodology</a> to understand how entries are vetted and cataloged.
            </p>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .editorial-contact-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 3rem;
    max-width: 960px;
    margin: 0 auto;
    box-shadow: var(--shadow-xs);
  }

  .contact-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2.25rem;
  }

  .category-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    background: var(--brand-teal-light);
    border: 1px solid var(--brand-teal-border);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .contact-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .contact-sub {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .contact-grid-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 0.75rem 0.95rem;
    font-family: inherit;
    font-size: 0.925rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--text-main);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--brand-teal);
    box-shadow: var(--shadow-glow);
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.85rem 1.75rem;
    background: var(--brand-teal);
    color: white;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: var(--radius-sm);
    margin-top: 0.5rem;
    transition: background 0.15s ease, transform 0.15s ease;
    align-self: flex-start;
  }

  .submit-btn:hover {
    background: var(--brand-teal-dark);
    transform: translateY(-1px);
  }

  .contact-guidelines {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .guide-box {
    padding: 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .guide-box-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    margin-bottom: 0.4rem;
  }

  .guide-box-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .link-teal {
    color: var(--brand-teal-deep);
    font-weight: 700;
    text-decoration: underline;
  }

  @media (max-width: 800px) {
    .editorial-contact-card { padding: 1.75rem; }
    .contact-grid-layout { grid-template-columns: 1fr; gap: 2rem; }
    .contact-title { font-size: 1.75rem; }
  }
</style>
