---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginatedNameList from '../../components/PaginatedNameList.astro';
import Sidebar from '../../components/Sidebar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';
import { KOREAN_NAMES } from '../../data/names';

export async function getStaticPaths() {
  return [
    {
      params: { gender: 'boy' },
      props: {
        genderName: 'Korean Boy Names',
        koreanTitle: '한국 남자 이름',
        desc: 'Explore authentic, strong, and meaningful Korean given names for baby boys with Hanja characters, stroke counts, and traditional virtues.'
      }
    },
    {
      params: { gender: 'girl' },
      props: {
        genderName: 'Korean Girl Names',
        koreanTitle: '한국 여자 이름',
        desc: 'Explore beautiful, graceful, and elegant Korean given names for baby girls with Hanja logograms, phonetic flow, and auspicious meanings.'
      }
    },
    {
      params: { gender: 'unisex' },
      props: {
        genderName: 'Unisex Korean Names',
        koreanTitle: '한국 중성 이름',
        desc: 'Discover modern gender-neutral Korean names with harmonious sounds suitable for both boys and girls.'
      }
    }
  ];
}

const { gender } = Astro.params;
const { genderName, koreanTitle, desc } = Astro.props;

const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const filteredNames = KOREAN_NAMES.filter(n => n.gender === gender);

const genderFaqs = [
  {
    question: `What makes a traditional Korean ${gender} name?`,
    answer: `Traditional Korean names for ${gender}s typically comprise two Sino-Korean syllables chosen to balance five cosmological elements alongside Confucian virtues such as wisdom, benevolence, or beauty.`
  },
  {
    question: `How do parents in Korea choose modern baby names today?`,
    answer: `Modern Korean parents often seek names that sound melodic, are easy to pronounce internationally, and carry positive Hanja character combinations on official birth certificates.`
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: genderName }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': `${genderName} Directory - Meanings & Hanja`,
  'description': desc,
  'url': `https://www.korean-names.info/gender/${gender}`
};
---

<BaseLayout
  title={`${genderName} - Authentic Meaning & Hanja Directory (${filteredNames.length} Names)`}
  description={desc}
  jsonLd={schema}
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <div class="content-layout">
      <!-- Main Content Column -->
      <main class="main-column">
        
        <header class="category-header-card">
          <span class="korean-badge">{koreanTitle}</span>
          <h1 class="category-main-title">
            {gender === 'girl' ? '🌸' : gender === 'boy' ? '👦' : '✳️'} {genderName}
          </h1>
          <p class="category-description-text">{desc}</p>
        </header>

        <!-- A-Z Letter Navigation Box -->
        <div class="az-filter-card">
          <span class="az-filter-label">Filter Alphabetically:</span>
          <div class="az-pills-row">
            {letters.map((l) => (
              <a href={`/letter/${l.toLowerCase()}`} class="az-filter-pill" aria-label={`Names starting with ${l}`}>
                {l}
              </a>
            ))}
          </div>
        </div>

        <!-- Directory Listing Header -->
        <div class="directory-results-bar">
          <span class="results-count-text">
            Showing <strong>{filteredNames.length}</strong> cataloged names
          </span>
        </div>

        <!-- Paginated Name Listing -->
        <PaginatedNameList names={filteredNames} />

        <!-- FAQ Section -->
        <FAQSection faqs={genderFaqs} title={`FAQ: ${genderName}`} />
      </main>

      <!-- Right Sidebar -->
      <aside class="sidebar-container">
        <Sidebar />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .category-header-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2.25rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-xs);
  }

  .korean-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    background: var(--brand-teal-light);
    border: 1px solid var(--brand-teal-border);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.65rem;
  }

  .category-main-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .category-description-text {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .az-filter-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .az-filter-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .az-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .az-filter-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xs);
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    transition: all 0.15s ease;
  }

  .az-filter-pill:hover {
    background: var(--brand-teal);
    color: white;
    border-color: var(--brand-teal);
  }

  .directory-results-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--brand-teal);
    margin-bottom: 1.25rem;
  }

  .results-count-text {
    font-size: 0.9rem;
    color: var(--text-body);
  }

  .results-count-text strong {
    color: var(--brand-teal-deep);
  }

  @media (max-width: 768px) {
    .category-header-card { padding: 1.5rem; }
    .category-main-title { font-size: 1.75rem; }
  }
</style>
