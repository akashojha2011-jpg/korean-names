---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import NameCard from '../components/NameCard.astro';
import FAQSection from '../components/FAQSection.astro';
import Sidebar from '../components/Sidebar.astro';
import { KOREAN_NAMES } from '../data/names';
import { SURNAMES } from '../data/surnames';
import { HANJA_ENTRIES } from '../data/hanja';

// Curate featured names for homepage spotlight
const featuredBoyNames = KOREAN_NAMES.filter((n) => n.gender === 'boy').slice(0, 4);
const featuredGirlNames = KOREAN_NAMES.filter((n) => n.gender === 'girl').slice(0, 4);
const featuredUnisexNames = KOREAN_NAMES.filter((n) => n.gender === 'unisex').slice(0, 4);

// Top 5 historic royal surnames
const topSurnames = SURNAMES.slice(0, 5);

// Featured Hanja characters
const featuredHanja = HANJA_ENTRIES.slice(0, 8);

// Alphabetical letters
const alphabetLetters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

const homeFaqs = [
  {
    question: 'How are traditional Korean given names structured?',
    answer: 'Traditional Korean given names usually consist of two Sino-Korean syllables written in Hangul (한글), with corresponding Hanja (漢字) logograms chosen for their positive virtues. Korean families may also use generational markers (Dollimja 돌림자), single-syllable names (외자), or native Pure Korean words (순우리말) like Haneul (Sky) or Areum (Beauty).'
  },
  {
    question: 'What is the role of Hanja in Korean names?',
    answer: 'Hanja refers to Chinese characters adapted into the Korean linguistic system. Even when two Korean names sound completely identical when spoken or written in Hangul (e.g. Min-jun 민준), different Hanja combinations give each person a distinct, recorded meaning on official civil registries.'
  },
  {
    question: 'Are Korean surnames placed first or last?',
    answer: 'In traditional Korean culture, the family surname comes first, followed by the two-syllable given name (e.g., Kim Min-jun, where Kim is the surname and Min-jun is the given name). When romanized in Western contexts, some individuals place their given name first, but in Korean documents, the surname always leads.'
  },
  {
    question: 'Can someone choose a Pure Korean (Soon-woori-mal) name without Hanja?',
    answer: 'Yes. Since the late 20th century, native Korean words that have no Hanja equivalent—such as Bora (Purple), Haneul (Sky), Bada (Ocean), and Areum (Beauty)—have grown increasingly popular and can be officially registered on South Korean birth records.'
  },
  {
    question: 'How does clan origin (Bon-gwan) affect Korean surnames?',
    answer: 'A Bon-gwan (본관) indicates the geographical ancestral seat where a family lineage originated. For example, Gimhae Kim and Gyeongju Kim share the same surname (Kim) but trace back to distinct royal founding ancestors and historical lineages.'
  }
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'KoreanNames.info',
  'url': 'https://www.korean-names.info',
  'description': 'Authentic Korean Name Dictionary, Hanja character meanings, surname clan origins, and naming traditions.'
};
---

<BaseLayout
  title="Korean Names: Authentic Dictionary, Surnames, Hanja & Meanings"
  description="Discover authentic Korean first names, surnames, Hanja logograms, and naming culture. Search by English, Hangul, or meaning with our free naming tools."
  jsonLd={websiteSchema}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-pattern-bg" aria-hidden="true">
      <span class="watermark-symbol s1">韓</span>
      <span class="watermark-symbol s2">字</span>
      <span class="watermark-symbol s3">美</span>
      <span class="watermark-symbol s4">智</span>
    </div>

    <div class="container hero-inner text-center">
      <div class="hero-badge-wrap">
        <span class="hero-korean-pill">🇰🇷 한국 이름 사전 · Korean Name Dictionary</span>
      </div>

      <h1 class="hero-heading">
        Authentic Korean Names Dictionary & Cultural Guide
      </h1>

      <p class="hero-subtext">
        Explore genuine Korean first names, historical surnames, Sino-Korean Hanja logograms, and ancient naming traditions. Curated for parents, writers, and cultural enthusiasts worldwide.
      </p>

      <!-- Prominent Search Interface -->
      <div class="hero-search-wrapper">
        <SearchBar large={true} placeholder="Search Korean names by English (Min-jun), Hangul (민준), or meaning (wisdom)..." />
      </div>

      <!-- Quick Directory Navigation Pills -->
      <nav class="hero-pills-nav" aria-label="Quick directory links">
        <a href="/gender/girl" class="hero-nav-pill pill-girl">🌸 Girl Names</a>
        <a href="/gender/boy" class="hero-nav-pill pill-boy">👦 Boy Names</a>
        <a href="/gender/unisex" class="hero-nav-pill pill-unisex">✳️ Unisex Names</a>
        <a href="/surname" class="hero-nav-pill">👑 Surnames</a>
        <a href="/hanja" class="hero-nav-pill">📜 Hanja Dictionary</a>
        <a href="/tools/name-generator" class="hero-nav-pill">🎲 Name Generator</a>
      </nav>
    </div>
  </section>

  <!-- Alphabetical Navigation Bar -->
  <section class="alphabet-bar-section">
    <div class="container">
      <div class="alphabet-inner">
        <span class="alphabet-label">Browse A–Z:</span>
        <div class="alphabet-links">
          {alphabetLetters.map((letter) => (
            <a href={`/letter/${letter.toLowerCase()}`} class="alphabet-letter-btn" aria-label={`Korean names starting with ${letter}`}>
              {letter}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <div class="container">
    <div class="content-layout">
      
      <!-- Primary Column -->
      <main class="main-column">
        
        <!-- Section: Popular Girl Names -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow eyebrow-girl">🌸 Beautiful & Graceful</span>
              <h2 class="section-title">Popular Korean Girl Names</h2>
            </div>
            <a href="/gender/girl" class="section-see-all-link">
              View All Girl Names &rarr;
            </a>
          </div>
          <p class="section-description">
            Beloved modern and traditional Korean baby girl names, carrying virtues of grace, radiance, floral beauty, and gentle wisdom.
          </p>

          <div class="names-cards-grid">
            {featuredGirlNames.map((name) => (
              <NameCard name={name} />
            ))}
          </div>
        </section>

        <!-- Section: Popular Boy Names -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow eyebrow-boy">👦 Strong & Virtuous</span>
              <h2 class="section-title">Popular Korean Boy Names</h2>
            </div>
            <a href="/gender/boy" class="section-see-all-link">
              View All Boy Names &rarr;
            </a>
          </div>
          <p class="section-description">
            Distinguished Korean baby boy names denoting scholarly wisdom, upright integrity, noble character, and physical strength.
          </p>

          <div class="names-cards-grid">
            {featuredBoyNames.map((name) => (
              <NameCard name={name} />
            ))}
          </div>
        </section>

        <!-- Section: Modern Unisex Names -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow eyebrow-unisex">✳️ Modern & Melodic</span>
              <h2 class="section-title">Trending Unisex Korean Names</h2>
            </div>
            <a href="/gender/unisex" class="section-see-all-link">
              View All Unisex Names &rarr;
            </a>
          </div>
          <p class="section-description">
            Contemporary gender-neutral Korean names favored by young parents in Seoul for their poetic sounds and universal harmony.
          </p>

          <div class="names-cards-grid">
            {featuredUnisexNames.map((name) => (
              <NameCard name={name} />
            ))}
          </div>
        </section>

        <!-- Interactive Name Generator Callout Banner -->
        <section class="generator-cta-card">
          <div class="cta-content">
            <span class="cta-pill">Interactive Naming Tool</span>
            <h2 class="cta-title">Korean Baby Name & Harmony Generator</h2>
            <p class="cta-text">
              Looking for the ideal name to pair with your family surname? Select your surname, preferred gender, and desired character virtue to discover matching combinations with phonetic harmony notes.
            </p>
            <div class="cta-actions">
              <a href="/tools/name-generator" class="cta-primary-btn">
                <span>Launch Name Generator</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a href="/tools/favorite-names" class="cta-secondary-btn">
                <span>View Bookmarked Names</span>
              </a>
            </div>
          </div>
        </section>

        <!-- Section: Korean Surnames (성씨와 본관) -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow">👑 Family Lineages & Clans</span>
              <h2 class="section-title">Major Korean Surnames (성씨)</h2>
            </div>
            <a href="/surname" class="section-see-all-link">
              View Surname Directory &rarr;
            </a>
          </div>
          <p class="section-description">
            More than half of the South Korean population shares the top five royal surnames. Explore their ancient clan seats (Bon-gwan) and genealogical histories.
          </p>

          <div class="surnames-cards-grid">
            {topSurnames.map((s) => (
              <a href={`/surname/${s.slug}`} class="surname-summary-card">
                <div class="surname-top">
                  <span class="s-hangul">{s.hangul}</span>
                  <span class="s-hanja">({s.hanja})</span>
                </div>
                <strong class="s-english">{s.english}</strong>
                <span class="s-meaning">"{s.meaning}"</span>
                <span class="s-clan" title={s.originClan}>{s.originClan.split('/')[0]}</span>
              </a>
            ))}
          </div>
        </section>

        <!-- Section: Essential Hanja Dictionary (인명용 한자) -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow">📜 Logograms & Meanings</span>
              <h2 class="section-title">Approved Naming Hanja (漢字)</h2>
            </div>
            <a href="/hanja" class="section-see-all-link">
              View Hanja Directory &rarr;
            </a>
          </div>
          <p class="section-description">
            Every Sino-Korean name is crafted from official characters approved by the Supreme Court of Korea. Inspect character stroke counts, radicals, and positive virtues.
          </p>

          <div class="hanja-cards-grid">
            {featuredHanja.map((h) => (
              <a href={`/hanja/${encodeURIComponent(h.hangul)}`} class="hanja-summary-card">
                <span class="h-char">{h.hanja}</span>
                <span class="h-hangul">{h.hangul}</span>
                <span class="h-meaning">{h.meaning}</span>
                <span class="h-strokes">{h.strokeCount} strokes</span>
              </a>
            ))}
          </div>
        </section>

        <!-- Cultural Educational Guides Preview -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow">📚 Cultural Knowledge</span>
              <h2 class="section-title">Korean Naming Traditions Explained</h2>
            </div>
            <a href="/acknowledgments" class="section-see-all-link">
              Learn More &rarr;
            </a>
          </div>
          <p class="section-description">
            Authoritative educational resources explaining how Korean naming systems, generational markers, and romanizations work.
          </p>

          <div class="guides-cards-grid">
            <article class="guide-card">
              <span class="guide-number">01</span>
              <h3 class="guide-card-title">Anatomy of a Korean Name</h3>
              <p class="guide-card-excerpt">
                Understand how family surnames, two-syllable given names, and Confucian generational markers (Dollimja) function in traditional and modern families.
              </p>
              <a href="/author" class="guide-card-link">Read Guide &rarr;</a>
            </article>

            <article class="guide-card">
              <span class="guide-number">02</span>
              <h3 class="guide-card-title">Hangul vs. Hanja Logograms</h3>
              <p class="guide-card-excerpt">
                Why identical-sounding Korean names can have radically different meanings, and how parents select characters from the Supreme Court registry.
              </p>
              <a href="/acknowledgments" class="guide-card-link">Read Guide &rarr;</a>
            </article>

            <article class="guide-card">
              <span class="guide-number">03</span>
              <h3 class="guide-card-title">Pure Korean (Soon-woori-mal) Names</h3>
              <p class="guide-card-excerpt">
                The modern trend of indigenous Korean names derived from natural beauty, flowers, and seasonal words without Chinese logographic roots.
              </p>
              <a href="/theme/nature" class="guide-card-link">Read Guide &rarr;</a>
            </article>
          </div>
        </section>

        <!-- Frequently Asked Questions -->
        <FAQSection faqs={homeFaqs} title="Frequently Asked Questions about Korean Names" renderSchema={true} />

      </main>

      <!-- Sidebar -->
      <aside class="sidebar-container">
        <Sidebar />
      </aside>

    </div>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     Hero Section
     ========================================================================== */
  .hero-section {
    position: relative;
    background: linear-gradient(180deg, var(--bg-hero) 0%, var(--bg-primary) 100%);
    padding: 4rem 0 3rem 0;
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .hero-pattern-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    user-select: none;
    opacity: 0.07;
    display: flex;
    justify-content: space-around;
    align-items: center;
    overflow: hidden;
  }

  .watermark-symbol {
    font-family: var(--font-korean);
    font-size: 13rem;
    font-weight: 900;
    color: var(--brand-teal);
    line-height: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 820px;
  }

  .hero-badge-wrap {
    margin-bottom: 1.25rem;
  }

  .hero-korean-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.95rem;
    background: var(--bg-surface);
    border: 1px solid var(--brand-teal-border);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    box-shadow: var(--shadow-xs);
  }

  .hero-heading {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text-main);
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
  }

  .hero-subtext {
    font-size: 1.1rem;
    color: var(--text-body);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-search-wrapper {
    margin-bottom: 1.75rem;
  }

  .hero-pills-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-nav-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-body);
    box-shadow: var(--shadow-xs);
    transition: all 0.15s ease;
  }

  .hero-nav-pill:hover {
    border-color: var(--brand-teal);
    color: var(--brand-teal-deep);
    background: var(--brand-teal-surface);
    transform: translateY(-1px);
  }

  .pill-girl:hover { border-color: var(--gender-girl); color: var(--gender-girl); }
  .pill-boy:hover { border-color: var(--gender-boy); color: var(--gender-boy); }
  .pill-unisex:hover { border-color: var(--gender-unisex); color: var(--gender-unisex); }

  /* ==========================================================================
     Alphabet Bar Section
     ========================================================================== */
  .alphabet-bar-section {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    padding: 0.65rem 0;
  }

  .alphabet-inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .alphabet-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .alphabet-links {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.15rem 0;
  }

  .alphabet-links::-webkit-scrollbar {
    display: none;
  }

  .alphabet-letter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xs);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .alphabet-letter-btn:hover {
    background: var(--brand-teal);
    color: white;
    border-color: var(--brand-teal);
  }

  /* ==========================================================================
     Showcase Sections
     ========================================================================== */
  .home-showcase-section {
    margin-top: 3.5rem;
  }

  .section-title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand-teal-deep);
    margin-bottom: 0.25rem;
  }

  .eyebrow-girl { color: var(--gender-girl); }
  .eyebrow-boy { color: var(--gender-boy); }
  .eyebrow-unisex { color: var(--gender-unisex); }

  .section-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .section-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .section-see-all-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .section-see-all-link:hover {
    color: var(--brand-teal);
    text-decoration: underline;
  }

  .names-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  /* Surnames Grid */
  .surnames-cards-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.85rem;
  }

  .surname-summary-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-align: center;
    box-shadow: var(--shadow-xs);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .surname-summary-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand-teal);
    box-shadow: var(--shadow-sm);
  }

  .surname-top {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .s-hangul {
    font-family: var(--font-korean);
    font-size: 1.85rem;
    font-weight: 900;
    color: var(--text-main);
  }

  .s-hanja {
    font-family: var(--font-korean);
    font-size: 1rem;
    color: var(--accent-indigo);
    font-weight: 700;
  }

  .s-english {
    font-size: 1rem;
    color: var(--brand-teal-deep);
    margin-bottom: 0.2rem;
  }

  .s-meaning {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .s-clan {
    font-size: 0.675rem;
    color: var(--text-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Hanja Cards Grid */
  .hanja-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .hanja-summary-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.25rem 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-align: center;
    box-shadow: var(--shadow-xs);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .hanja-summary-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand-teal);
    background: var(--brand-teal-surface);
  }

  .h-char {
    font-family: var(--font-korean);
    font-size: 2.25rem;
    font-weight: 900;
    color: var(--accent-indigo);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .h-hangul {
    font-family: var(--font-hangul);
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .h-meaning {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0.5rem 0;
    line-height: 1.25;
  }

  .h-strokes {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--brand-teal-deep);
    background: var(--brand-teal-light);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
  }

  /* Generator CTA Banner */
  .generator-cta-card {
    margin-top: 3.5rem;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--brand-teal-surface) 0%, var(--bg-surface) 100%);
    border: 2px solid var(--brand-teal-border);
    box-shadow: var(--shadow-sm);
  }

  .cta-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand-teal-deep);
    background: var(--brand-teal-light);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .cta-text {
    font-size: 0.975rem;
    color: var(--text-body);
    line-height: 1.6;
    max-width: 680px;
    margin-bottom: 1.5rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .cta-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1.4rem;
    background: var(--brand-teal);
