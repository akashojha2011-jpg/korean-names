---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import NameCard from '../components/NameCard.astro';
import FAQSection from '../components/FAQSection.astro';
import Sidebar from '../components/Sidebar.astro';
import { KOREAN_NAMES } from '../data/names';
import { SURNAMES } from '../data/surnames';
import { HANJA_ENTRIES } from '../data/hanja';

// Curate featured names for homepage spotlight
const featuredBoyNames = KOREAN_NAMES.filter((n) => n.gender === 'boy').slice(0, 4);
const featuredGirlNames = KOREAN_NAMES.filter((n) => n.gender === 'girl').slice(0, 4);
const featuredUnisexNames = KOREAN_NAMES.filter((n) => n.gender === 'unisex').slice(0, 4);

// Top 5 historic royal surnames
const topSurnames = SURNAMES.slice(0, 5);

// Featured Hanja characters
const featuredHanja = HANJA_ENTRIES.slice(0, 8);

// Alphabetical letters
const alphabetLetters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

const homeFaqs = [
  {
    question: 'How do Korean names work and how are they structured?',
    answer: 'Korean names traditionally consist of three syllables: a single-syllable family surname followed by a two-syllable given name (e.g., Kim Min-jun). Each given syllable typically represents a Sino-Korean Hanja character with a distinct meaning chosen by parents or naming specialists.'
  },
  {
    question: 'Are Korean names last name first?',
    answer: 'Yes. In traditional Korean naming culture, the family surname always comes first, followed by the given name (e.g., in "Park Seo-jun", "Park" is the surname and "Seo-jun" is the given name). While some Koreans flip the order when writing for Western audiences, the surname always leads in Korea.'
  },
  {
    question: 'Do Korean people have middle names?',
    answer: 'No, traditional Korean names do not have middle names. A person has only their family surname and given name. Some families use generational marker syllables (Dollimja 돌림자) shared across siblings or cousins, but these are integrated directly into the two-syllable given name, not as a middle name.'
  },
  {
    question: 'Why are Korean names hyphenated?',
    answer: 'Korean given names are commonly hyphenated in English (such as Min-jun or Seo-ah) under the official Revised Romanization system to prevent phonetic ambiguity and clearly separate the two distinct Hangul syllables.'
  },
  {
    question: 'What is the role of Hanja in Korean names?',
    answer: 'Hanja refers to Chinese logograms adapted into the Korean linguistic system. Even when two Korean names look and sound identical in Hangul (e.g., Min-jun 민준), different Hanja character combinations give each person a distinct, legally registered meaning on civil birth registers.'
  },
  {
    question: 'What are Pure Korean (Soon-woori-mal) names?',
    answer: 'Pure Korean names are native Korean words that carry direct poetic meanings without Chinese Hanja roots—such as Ha-neul (Sky), A-reum (Beauty), Bo-ra (Purple), and Ba-da (Ocean).'
  },
  {
    question: 'How do you pronounce Korean names accurately?',
    answer: 'Korean pronunciation follows specific phonetic rules such as consonant aspiration and final consonant (batchim) flow. KoreanNames.info provides native voice audio pronunciation buttons on every name profile.'
  }
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'KoreanNames.info',
  'url': 'https://www.korean-names.info',
  'description': 'Authentic Korean Name Dictionary: explore Korean names and meanings, Hanja characters, surname clan origins, and naming traditions.'
};
---

<BaseLayout
  title="Korean Names and Meanings: Authentic Dictionary, Surnames & Hanja"
  description="Explore authentic Korean names, meanings, and origins. Discover popular Korean names for girls, boys, and unisex with Hangul characters, Hanja, and native pronunciation."
  jsonLd={websiteSchema}
>
  <!-- Breadcrumb Navigation -->
  <div class="breadcrumb-container">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="bc-sep">&gt;</span>
        <span class="bc-current">Korean Baby Names</span>
      </nav>
    </div>
  </div>

  <!-- Hero Banner Section (The Bump Style) -->
  <section class="bump-hero-section">
    <div class="container">
      <div class="bump-hero-card">
        <h1 class="bump-hero-title">Korean Baby Names</h1>

        <!-- 4-Segment Action Bar -->
        <div class="hero-action-bar">
          <a href="/names" class="hero-action-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            <span>Explore Lists</span>
          </a>
          <a href="/name-generator" class="hero-action-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Tools & Generator</span>
          </a>
          <a href="/favorites" class="hero-action-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            <span>My Favorites</span>
          </a>
          <a href="/name-finder" class="hero-action-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Search Names</span>
          </a>
        </div>

        <!-- Filter Tag Pills -->
        <nav class="bump-tag-pills" aria-label="Name Categories">
          <a href="/names" class="tag-pill active">Popular Names</a>
          <a href="/boy-names" class="tag-pill">Boy Names</a>
          <a href="/girl-names" class="tag-pill">Girl Names</a>
          <a href="/unisex-names" class="tag-pill">Gender-Neutral Names</a>
          <a href="/names/letter/a" class="tag-pill">A-Z Names</a>
          <a href="/names/meaning" class="tag-pill">Names by Meaning</a>
          <a href="/surnames" class="tag-pill">Surnames</a>
          <a href="/hanja" class="tag-pill">Hanja</a>
        </nav>

        <!-- Editorial Byline & Social Share Strip -->
        <div class="bump-byline-strip">
          <div class="byline-left">
            <span class="byline-author">By <strong>Korean Names Editorial Team</strong></span>
            <span class="byline-dot">·</span>
            <span class="byline-date">Updated November 2026</span>
          </div>
          <div class="byline-share">
            <a href="https://www.facebook.com/sharer/sharer.php?u=https://www.korean-names.info" target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="Share on Facebook" title="Share on Facebook">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://twitter.com/intent/tweet?url=https://www.korean-names.info&text=Authentic%20Korean%20Baby%20Names" target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="Share on X" title="Share on X">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <button type="button" class="share-icon-btn" id="copy-page-link-btn" aria-label="Copy link to clipboard" title="Copy link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </button>
            <a href="mailto:?subject=Korean%20Baby%20Names&body=Check%20out%20KoreanNames.info%20for%20authentic%20Korean%20names:%20https://www.korean-names.info" class="share-icon-btn" aria-label="Share via Email" title="Email link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </a>
          </div>
        </div>

        <!-- Welcoming Editorial Lead Text -->
        <p class="bump-lead-text">
          Looking for Korean baby names? Whether you want a traditional Korean name rooted in ancestral culture, a modern name popular in Seoul, or an auspicious choice built from Sino-Korean Hanja characters, explore our comprehensive collection of Korean girl names, boy names, and gender-neutral options with verified Hangul spellings and native pronunciation.
        </p>

        <!-- Prominent Minimal Search Bar -->
        <div class="bump-search-box">
          <SearchBar large={true} placeholder="Search Korean names by English (e.g. Min-jun), Hangul (민준), or meaning..." />
        </div>
      </div>
    </div>
  </section>

  <!-- Alphabetical Navigation Bar -->
  <section class="alphabet-bar-section">
    <div class="container">
      <div class="alphabet-inner">
        <span class="alphabet-label">Browse A–Z:</span>
        <div class="alphabet-links">
          {alphabetLetters.map((letter) => (
            <a href={`/names/letter/${letter.toLowerCase()}`} class="alphabet-letter-btn" aria-label={`Korean names starting with ${letter}`}>
              {letter}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <div class="container">
    <div class="content-layout">
      
      <!-- Primary Column -->
      <main class="main-column">
        
        <!-- Directory Header -->
        <div class="directory-section-header">
          <h2 class="directory-main-title">Explore Korean Baby Girl and Boy Names</h2>
          <p class="directory-main-lead">
            Browse authentic Korean names by category, popularity, and character meanings. Each name includes verified Hangul spelling, approved Supreme Court Hanja characters, and native audio pronunciation.
          </p>
        </div>

        <!-- Section: Popular Girl Names -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow eyebrow-girl">Graceful & Radiant</span>
              <h3 class="section-title">Popular Korean Girl Names</h3>
            </div>
            <a href="/girl-names" class="section-see-all-link">
              View All Girl Names &rarr;
            </a>
          </div>
          <p class="section-description">
            Beloved modern and traditional Korean baby girl names carrying virtues of elegance, floral beauty, clarity, and gentle wisdom.
          </p>

          <div class="names-cards-grid">
            {featuredGirlNames.map((name) => (
              <NameCard name={name} />
            ))}
          </div>
        </section>

        <!-- Section: Popular Boy Names -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow eyebrow-boy">Strong & Virtuous</span>
              <h3 class="section-title">Popular Korean Boy Names</h3>
            </div>
            <a href="/boy-names" class="section-see-all-link">
              View All Boy Names &rarr;
            </a>
          </div>
          <p class="section-description">
            Distinguished Korean baby boy names denoting scholarly wisdom, upright integrity, noble character, and enduring strength.
          </p>

          <div class="names-cards-grid">
            {featuredBoyNames.map((name) => (
              <NameCard name={name} />
            ))}
          </div>
        </section>

        <!-- Section: Modern Unisex Names -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow eyebrow-unisex">Modern & Melodic</span>
              <h3 class="section-title">Trending Unisex Korean Names</h3>
            </div>
            <a href="/unisex-names" class="section-see-all-link">
              View All Unisex Names &rarr;
            </a>
          </div>
          <p class="section-description">
            Contemporary gender-neutral Korean names favored by parents for their poetic balance and universal international harmony.
          </p>

          <div class="names-cards-grid">
            {featuredUnisexNames.map((name) => (
              <NameCard name={name} />
            ))}
          </div>
        </section>

        <!-- Interactive Name Generator Callout Banner -->
        <section class="generator-cta-card">
          <div class="cta-content">
            <span class="cta-pill">Interactive Naming Tool</span>
            <h3 class="cta-title">Korean Baby Name & Harmony Generator</h3>
            <p class="cta-text">
              Looking for the ideal name to pair with your family surname? Select your surname, preferred gender, and desired character virtue to discover matching combinations with phonetic harmony notes.
            </p>
            <div class="cta-actions">
              <a href="/name-generator" class="cta-primary-btn">
                <span>Launch Name Generator</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a href="/favorites" class="cta-secondary-btn">
                <span>View Saved Favorites</span>
              </a>
            </div>
          </div>
        </section>

        <!-- Section: Korean Surnames (성씨와 본관) -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow">Family Lineages & Clans</span>
              <h3 class="section-title">Major Korean Surnames</h3>
            </div>
            <a href="/surnames" class="section-see-all-link">
              View Surname Directory &rarr;
            </a>
          </div>
          <p class="section-description">
            More than half of the South Korean population shares the top five royal surnames. Explore their ancestral clan seats (Bon-gwan) and genealogical histories.
          </p>

          <div class="surnames-cards-grid">
            {topSurnames.map((s) => (
              <a href={`/surnames/${s.slug}`} class="surname-summary-card">
                <div class="surname-top">
                  <span class="s-hangul">{s.hangul}</span>
                  <span class="s-hanja">({s.hanja})</span>
                </div>
                <strong class="s-english">{s.english}</strong>
                <span class="s-meaning">"{s.meaning}"</span>
                <span class="s-clan" title={s.originClan}>{s.originClan.split('/')[0]}</span>
              </a>
            ))}
          </div>
        </section>

        <!-- Section: Essential Hanja Dictionary (인명용 한자) -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow">Logograms & Meanings</span>
              <h3 class="section-title">Approved Naming Hanja</h3>
            </div>
            <a href="/hanja" class="section-see-all-link">
              View Hanja Directory &rarr;
            </a>
          </div>
          <p class="section-description">
            Every Sino-Korean name is crafted from official characters approved by the Supreme Court of Korea. Inspect character stroke counts, radicals, and auspicious virtues.
          </p>

          <div class="hanja-cards-grid">
            {featuredHanja.map((h) => (
              <a href={`/hanja/${encodeURIComponent(h.hangul)}`} class="hanja-summary-card">
                <span class="h-char">{h.hanja}</span>
                <span class="h-hangul">{h.hangul}</span>
                <span class="h-meaning">{h.meaning}</span>
                <span class="h-strokes">{h.strokeCount} strokes</span>
              </a>
            ))}
          </div>
        </section>

        <!-- Cultural Educational Guides Preview -->
        <section class="home-showcase-section">
          <div class="section-title-row">
            <div>
              <span class="section-eyebrow">Cultural Knowledge</span>
              <h3 class="section-title">Korean Naming Traditions Explained</h3>
            </div>
            <a href="/guides" class="section-see-all-link">
              View All Guides &rarr;
            </a>
          </div>
          <p class="section-description">
            Educational resources explaining how Korean naming structures, generational markers (Dollimja), and Hanja logograms function.
          </p>

          <div class="guides-cards-grid">
            <article class="guide-card">
              <span class="guide-number">01</span>
              <h4 class="guide-card-title">Anatomy of a Korean Name</h4>
              <p class="guide-card-excerpt">
                Understand how family surnames, two-syllable given names, and Confucian generational markers function in traditional and modern families.
              </p>
              <a href="/guides/how-korean-names-work" class="guide-card-link">Read Guide &rarr;</a>
            </article>

            <article class="guide-card">
              <span class="guide-number">02</span>
              <h4 class="guide-card-title">Hangul vs. Hanja Logograms</h4>
              <p class="guide-card-excerpt">
                Why identical-sounding Korean names can have radically different meanings, and how parents select characters from the Supreme Court registry.
              </p>
              <a href="/guides/hangul-vs-hanja" class="guide-card-link">Read Guide &rarr;</a>
            </article>

            <article class="guide-card">
              <span class="guide-number">03</span>
              <h4 class="guide-card-title">Pure Korean Names</h4>
              <p class="guide-card-excerpt">
                The modern trend of indigenous Korean names derived from natural beauty, flowers, and seasonal words without Chinese logographic roots.
              </p>
              <a href="/guides/pure-korean-names" class="guide-card-link">Read Guide &rarr;</a>
            </article>
          </div>
        </section>

        <!-- Frequently Asked Questions -->
        <FAQSection faqs={homeFaqs} title="Frequently Asked Questions about Korean Names" renderSchema={true} />

      </main>

      <!-- Sidebar -->
      <aside class="sidebar-container">
        <Sidebar />
      </aside>

    </div>
  </div>

  <script>
    const copyBtn = document.getElementById('copy-page-link-btn');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalTitle = copyBtn.getAttribute('title') || 'Copy link';
        copyBtn.setAttribute('title', 'Copied to clipboard!');
        setTimeout(() => {
          copyBtn.setAttribute('title', originalTitle);
        }, 2000);
      } catch (e) {
        // clipboard unavailable
      }
    });
  </script>
</BaseLayout>

<style>
  /* ==========================================================================
     Breadcrumbs
     ========================================================================== */
  .breadcrumb-container {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.75rem 0;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-nav a:hover {
    color: var(--color-jade);
  }

  .bc-sep {
    font-size: 0.75rem;
    color: var(--border-strong);
  }

  .bc-current {
    color: var(--text-main);
    font-weight: 600;
  }

  /* ==========================================================================
     Bump Hero Banner Section
     ========================================================================== */
  .bump-hero-section {
    background: var(--bg-primary);
    padding: 1.5rem 0 2rem 0;
  }

  .bump-hero-card {
    background: var(--bg-surface-warm);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem 2rem 2rem;
    box-shadow: var(--shadow-xs);
  }

  .bump-hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  /* 4-Segment Action Bar */
  .hero-action-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-xs);
  }

  .hero-action-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
    border-right: 1px solid var(--border-color);
    transition: all 0.15s ease;
  }

  .hero-action-item:last-child {
    border-right: none;
  }

  .hero-action-item svg {
    color: var(--color-jade);
    flex-shrink: 0;
  }

  .hero-action-item:nth-child(3) svg {
    color: var(--color-burgundy);
  }

  .hero-action-item:hover {
    background: var(--bg-surface-muted);
    color: var(--color-jade);
  }

  /* Filter Tag Pills */
  .bump-tag-pills {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-body);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .tag-pill:hover,
  .tag-pill.active {
    background: var(--color-jade-surface);
    border-color: var(--color-jade);
    color: var(--color-jade);
  }

  /* Editorial Byline Strip */
  .bump-byline-strip {
