---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { EDUCATIONAL_GUIDES, type GuideArticle } from '../../data/guides';

export async function getStaticPaths() {
  return EDUCATIONAL_GUIDES.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideArticle;
}

const { guide } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn' },
  { label: guide.title },
];

const relatedArticles = guide.relatedGuides
  .map((relSlug) => EDUCATIONAL_GUIDES.find((g) => g.slug === relSlug))
  .filter(Boolean) as GuideArticle[];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': guide.title,
  'alternativeHeadline': guide.koreanTitle,
  'description': guide.excerpt,
  'inLanguage': 'en-US',
  'datePublished': '2024-01-01',
  'dateModified': '2026-01-01',
  'author': {
    '@type': 'Organization',
    'name': 'Korean Names Information Editorial Board',
    'url': 'https://www.korean-names.info/about',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Korean-Names.info',
    'url': 'https://www.korean-names.info',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://www.korean-names.info/logo.jpg',
    },
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': `https://www.korean-names.info/learn/${guide.slug}`,
  },
};
---

<BaseLayout
  title={`${guide.title} - Korean Naming Guide`}
  description={guide.excerpt}
  canonicalUrl={`https://www.korean-names.info/learn/${guide.slug}`}
  jsonLd={articleSchema}
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <!-- Article Header -->
    <header class="article-header">
      <div class="article-meta-row">
        <span class="category-pill">{guide.category.replace('-', ' ').toUpperCase()}</span>
        <span class="read-time font-mono">{guide.readTime}</span>
        <span class="publish-date">{guide.publishedDate}</span>
      </div>

      <span class="korean-subhead font-hangul">{guide.koreanTitle}</span>
      <h1 class="article-headline">{guide.title}</h1>
      <p class="article-lead">{guide.subtitle}</p>

      <div class="authority-attribution">
        <span class="auth-icon">🏛️</span>
        <span>Authored by the Editorial Research Board · Verified against Supreme Court & NIIED records</span>
      </div>
    </header>

    <!-- Main Content Layout -->
    <div class="article-body-layout">
      <!-- Article Content -->
      <article class="article-content">
        {guide.content.map((sec, index) => (
          <section class="guide-section">
            <h2 class="section-title">{sec.sectionHeading}</h2>
            {sec.paragraphs.map(p => (
              <p class="section-para">{p}</p>
            ))}

            {sec.callout && (
              <aside class="guide-callout-box" aria-label="Cultural insight">
                <div class="callout-badge font-hangul">알아두기</div>
                <div class="callout-body">
                  <h3 class="callout-title">{sec.callout.title}</h3>
                  <p class="callout-text">{sec.callout.body}</p>
                </div>
              </aside>
            )}
          </section>
        ))}

        <!-- Primary Sources Citation Block -->
        {guide.references && guide.references.length > 0 && (
          <section class="sources-citation-card">
            <h3 class="citation-title">Primary Sources & Statutory References</h3>
            <ul class="citation-list">
              {guide.references.map(ref => (
                <li class="citation-item">
                  <strong>{ref.title}</strong> — <span class="ref-source">{ref.source}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="article-sidebar">
        <div class="sidebar-box toc-box">
          <h4 class="sidebar-heading">Article Sections</h4>
          <ol class="toc-list">
            {guide.content.map(sec => (
              <li>
                <span class="toc-text">{sec.sectionHeading}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="sidebar-box tools-jump-box">
          <h4 class="sidebar-heading">Interactive Tools</h4>
          <ul class="sidebar-tools-list">
            <li><a href="/names">Search Names Directory &rarr;</a></li>
            <li><a href="/name-generator">Name & Surname Generator &rarr;</a></li>
            <li><a href="/name-finder">English Name Transliteration &rarr;</a></li>
            <li><a href="/name-comparison">Side-by-Side Comparison &rarr;</a></li>
            <li><a href="/certificate">Print Name Certificate &rarr;</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <!-- Related Articles -->
    {relatedArticles.length > 0 && (
      <section class="related-guides-section">
        <h3 class="related-section-title">Continue Exploring Korean Naming Culture</h3>
        <div class="related-guides-grid">
          {relatedArticles.map(rel => (
            <a href={`/learn/${rel.slug}`} class="related-guide-card">
              <span class="rel-cat">{rel.category.replace('-', ' ').toUpperCase()}</span>
              <h4 class="rel-title">{rel.title}</h4>
              <p class="rel-excerpt">{rel.excerpt}</p>
              <span class="rel-link">Read Guide &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  .article-header {
    background: linear-gradient(135deg, var(--bg-surface) 0%, #EDE6D8 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .article-meta-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .category-pill {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: var(--brand-jade);
    color: #FFFFFF;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .read-time, .publish-date {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .korean-subhead {
    display: block;
    font-size: 1.1rem;
    color: var(--antique-gold);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .article-headline {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .article-lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 820px;
    margin-bottom: 1.75rem;
  }

  .authority-attribution {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.85rem;
    color: var(--brand-navy);
    font-weight: 600;
  }

  .article-body-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .article-content {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 3rem;
    box-shadow: var(--shadow-sm);
  }

  .guide-section {
    margin-bottom: 2.75rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    color: var(--brand-navy);
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .section-para {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .guide-callout-box {
    display: flex;
    gap: 1.25rem;
    background: #FAF8F2;
    border: 1px solid var(--antique-gold);
    border-left: 4px solid var(--brand-jade);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .callout-badge {
    background: var(--brand-jade);
    color: white;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    height: fit-content;
    white-space: nowrap;
  }

  .callout-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--brand-navy);
    margin-bottom: 0.35rem;
  }

  .callout-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-main);
    margin: 0;
  }

  /* Citations Card */
  .sources-citation-card {
    background: #FAF8F2;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-top: 3rem;
  }

  .citation-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--brand-navy);
    margin-bottom: 1rem;
  }

  .citation-list {
    padding-left: 1.25rem;
    font-size: 0.92rem;
    color: var(--text-main);
    line-height: 1.7;
  }

  .ref-source {
    color: var(--text-muted);
    font-style: italic;
  }

  /* Sidebar */
  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .sidebar-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .sidebar-heading {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--brand-navy);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .toc-list {
    padding-left: 1.2rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-main);
  }

  .sidebar-tools-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .sidebar-tools-list a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand-jade);
    text-decoration: none;
  }

  .sidebar-tools-list a:hover {
    color: var(--accent-burgundy);
  }

  /* Related Guides */
  .related-guides-section {
    padding-top: 3rem;
    border-top: 2px solid var(--border-color);
  }

  .related-section-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--text-main);
    margin-bottom: 1.75rem;
  }

  .related-guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .related-guide-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .related-guide-card:hover {
    border-color: var(--brand-jade);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .rel-cat {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--antique-gold);
    margin-bottom: 0.4rem;
  }

  .rel-title {
    font-size: 1.15rem;
    color: var(--brand-navy);
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.65rem;
  }

  .rel-excerpt {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .rel-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--brand-jade);
  }

  @media (max-width: 900px) {
    .article-body-layout {
      grid-template-columns: 1fr;
    }
    .article-content {
      padding: 1.75rem;
    }
  }
</style>
