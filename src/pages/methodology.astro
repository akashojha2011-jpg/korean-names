---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Research Methodology' }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemPage',
  'name': 'Korean-Names.info Research Methodology & Verification Standards',
  'url': 'https://www.korean-names.info/methodology',
  'description': 'Our 5-stage research methodology for validating Korean names, Hanja logograms, phonetic romanization, and demographic popularity statistics.'
};
---

<BaseLayout
  title="Research Methodology - Korean Nomenclature Verification Standards"
  description="Learn how Korean-Names.info researches and validates Korean personal names. Explore our 5-stage verification protocol, phonetic harmonization, and statutory audits."
  jsonLd={schema}
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="method-hero">
      <div class="heritage-tag">
        <span class="emblem font-hangul">연구 방법론</span>
        <span>Linguistic Verification Standards</span>
      </div>
      <h1 class="method-title">Nomenclature Research Methodology</h1>
      <p class="method-subtitle">
        How Korean-Names.info collects, cross-references, validates, and maintains the most accurate
        encyclopedia of Korean personal names and ancestral clan genealogies.
      </p>
    </header>

    <!-- 5-Stage Protocol Timeline -->
    <div class="protocol-timeline">
      <div class="stage-card">
        <div class="stage-number font-mono">STAGE 01</div>
        <h2 class="stage-title">Statutory Civil Registry Audit</h2>
        <p class="stage-desc">
          Every candidate name begins with statutory verification. Under South Korean civil registration law
          (Family Relationship Act / 가족관계의 등록 등에 관한 법률), given names are subject to strict legal guidelines.
          We audit every proposed character against the Supreme Court Table of Hanja for Personal Names (8,400+ characters),
          confirming official radical, standard stroke count, and legal registration eligibility.
        </p>
      </div>

      <div class="stage-card">
        <div class="stage-number font-mono">STAGE 02</div>
        <h2 class="stage-title">Linguistic Classification & Origin Verification</h2>
        <p class="stage-desc">
          Names are strictly categorized by their linguistic lineage:
        </p>
        <ul class="stage-list">
          <li><strong>Sino-Korean (한자어):</strong> Cross-referenced with historical East Asian lexicography to document every distinct character homophone.</li>
          <li><strong>Pure Native Korean (순우리말):</strong> Authenticated via the National Institute of Korean Language (국립국어원) Standard Korean Dictionary to verify authentic etymology.</li>
        </ul>
      </div>

      <div class="stage-card">
        <div class="stage-number font-mono">STAGE 03</div>
        <h2 class="stage-title">Phonetic Realization & Dual Romanization</h2>
        <p class="stage-desc">
          Korean phonology features complex sound changes (음운 변동) such as nasalization (비음화), liquidization (유음화),
          and liaison (연음). We provide:
        </p>
        <ul class="stage-list">
          <li><strong>Revised Romanization (RR):</strong> Official national standard enacted by the Ministry of Culture in 2000.</li>
          <li><strong>McCune-Reischauer:</strong> Traditional academic system widely used in Western scholarship.</li>
          <li><strong>International Phonetic Alphabet (IPA):</strong> Precise acoustic realization transcriptions (e.g., [min.dʑun]).</li>
        </ul>
      </div>

      <div class="stage-card">
        <div class="stage-number font-mono">STAGE 04</div>
        <h2 class="stage-title">Surname & Tonal Harmony Modeling</h2>
        <p class="stage-desc">
          Because family surnames precede given names in Korean culture, we model acoustic harmony across Korea's
          top ancestral royal surnames (Kim, Lee, Park, Choi, Jung). Our harmony algorithm evaluates consonant stops (받침)
          and vowel transitions to highlight natural phonetic flow without vocalic friction.
        </p>
      </div>

      <div class="stage-card">
        <div class="stage-number font-mono">STAGE 05</div>
        <h2 class="stage-title">Demographic Census Cross-Referencing</h2>
        <p class="stage-desc">
          Popularity ranks, birth frequencies, and clan populations are tied directly to official decennial
          Population and Housing Census records released by Statistics Korea (통계청) and the Supreme Court Electronic
          Family Relationship Registration System.
        </p>
      </div>
    </div>

    <!-- Institutional Citations Banner -->
    <section class="sources-link-card">
      <h3 class="sources-card-title">Inspect Primary Statutory References</h3>
      <p class="sources-card-desc">
        Review the full list of official statutory decrees, government registries, and academic dictionaries cited across our platform.
      </p>
      <a href="/sources" class="btn btn-primary">View Statutory Sources Directory &rarr;</a>
    </section>

  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  .method-hero {
    background: linear-gradient(135deg, var(--bg-surface) 0%, #EDE6D8 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 3.5rem 2.5rem;
    margin-bottom: 3rem;
    box-shadow: var(--shadow-sm);
  }

  .heritage-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-surface);
    border: 1px solid var(--color-gold);
    color: var(--color-jade);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .heritage-tag .emblem {
    color: var(--color-burgundy);
    border-right: 1px solid var(--border-color);
    padding-right: 0.5rem;
  }

  .method-title {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
    margin-bottom: 1rem;
    max-width: 900px;
  }

  .method-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 820px;
  }

  .protocol-timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .stage-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-left: 5px solid var(--color-jade);
    border-radius: var(--radius-md);
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }

  .stage-card:hover {
    border-color: var(--color-jade);
    transform: translateX(4px);
  }

  .stage-number {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-burgundy);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .stage-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-navy);
    font-weight: 700;
    margin-bottom: 0.85rem;
  }

  .stage-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-main);
    margin-bottom: 0.75rem;
  }

  .stage-list {
    padding-left: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-main);
  }

  .sources-link-card {
    background: #FAF8F2;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    text-align: center;
  }

  .sources-card-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .sources-card-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 620px;
    margin: 0 auto 1.5rem;
  }
</style>
