---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NameCard from '../../components/NameCard.astro';
import { KOREAN_NAMES } from '../../data/names';
import type { KoreanName } from '../../types/name';

export async function getStaticPaths() {
  return KOREAN_NAMES.map((name) => ({
    params: { slug: name.slug },
    props: { name }
  }));
}

export interface Props {
  name: KoreanName;
}

const { name } = Astro.props;

// Related authentic names (same gender, excluding self)
const relatedNames = KOREAN_NAMES.filter(
  (n) => n.gender === name.gender && n.slug !== name.slug
).slice(0, 4);

// Top surname pairing combinations
const surnamePairings = [
  { surname: 'Kim', hangul: '김', hanja: '金', fullHangul: `김${name.hangul}`, fullEnglish: `Kim ${name.english.split(' ')[0]}` },
  { surname: 'Lee', hangul: '이', hanja: '李', fullHangul: `이${name.hangul}`, fullEnglish: `Lee ${name.english.split(' ')[0]}` },
  { surname: 'Park', hangul: '박', hanja: '朴', fullHangul: `박${name.hangul}`, fullEnglish: `Park ${name.english.split(' ')[0]}` },
  { surname: 'Choi', hangul: '최', hanja: '崔', fullHangul: `최${name.hangul}`, fullEnglish: `Choi ${name.english.split(' ')[0]}` },
  { surname: 'Jung', hangul: '정', hanja: '鄭', fullHangul: `정${name.hangul}`, fullEnglish: `Jung ${name.english.split(' ')[0]}` },
];

const genderLabel = name.gender === 'boy' ? 'Boy (남성)' : name.gender === 'girl' ? 'Girl (여성)' : 'Unisex (중성)';
const genderBadgeClass = name.gender === 'boy' ? 'badge-boy' : name.gender === 'girl' ? 'badge-girl' : 'badge-unisex';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: `${name.gender === 'boy' ? 'Boy Names' : name.gender === 'girl' ? 'Girl Names' : 'Unisex Names'}`, href: `/gender/${name.gender}` },
  { label: `${name.english} (${name.hangul})` }
];

const nameSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  'name': name.english,
  'termCode': name.hangul,
  'description': name.overallMeaning,
  'inDefinedTermSet': 'https://www.korean-names.info'
};
---

<BaseLayout
  title={`${name.english} (${name.hangul}) - Korean Name Meaning, Hanja & Pronunciation`}
  description={`Discover the meaning, Hanja characters (${name.hanja || 'Pure Korean'}), pronunciation, and surname harmony for the Korean name ${name.english} (${name.hangul}).`}
  jsonLd={nameSchema}
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <div class="content-layout">
      <!-- Main Content Column -->
      <main class="main-column">
        
        <!-- Name Header Profile Card -->
        <header class="name-hero-profile">
          <div class="profile-top-bar">
            <div class="badge-cluster">
              <span class={`badge ${genderBadgeClass}`}>{genderLabel}</span>
              {name.isTrending && name.popularityRank && name.popularityRank <= 30 && (
                <span class="badge badge-gold">Top {name.popularityRank} Baby Name</span>
              )}
            </div>

            <div class="profile-actions">
              <BookmarkButton slug={name.slug} nameEnglish={name.english} />
              <button id="share-name-btn" class="action-circle-btn" title="Copy shareable link" aria-label="Share link">
                🔗
              </button>
            </div>
          </div>

          <div class="profile-char-block">
            <span class="hangul-hero-text">{name.hangul}</span>
            {name.hanja && <span class="hanja-hero-text">({name.hanja})</span>}
          </div>

          <h1 class="profile-english-name">{name.english}</h1>
          <p class="profile-meaning-lead">"{name.overallMeaning}"</p>

          <div class="audio-banner-box">
            <span class="audio-instruction">Listen to native Korean voice pronunciation:</span>
            <AudioPlayer text={name.hangul} size="lg" label={`Pronounce "${name.hangul}"`} />
          </div>
        </header>

        <!-- Fast Facts Key-Value Table -->
        <section class="editorial-box facts-box">
          <h2 class="box-heading">Key Linguistic Facts & Romanization</h2>

          <div class="facts-grid">
            <div class="fact-row">
              <span class="fact-label">Hangul (Alphabet)</span>
              <span class="fact-value font-hangul">{name.hangul}</span>
            </div>

            <div class="fact-row">
              <span class="fact-label">Primary Hanja (Logograms)</span>
              <span class="fact-value font-hanja">{name.hanja || 'None (Native Pure Korean)'}</span>
            </div>

            <div class="fact-row">
              <span class="fact-label">Revised Romanization (RR)</span>
              <span class="fact-value">{name.revisedRomanization || name.slug} (Official)</span>
            </div>

            <div class="fact-row">
              <span class="fact-label">McCune-Reischauer</span>
              <span class="fact-value">{name.mccuneReischauer || name.slug} (Traditional)</span>
            </div>

            <div class="fact-row">
              <span class="fact-label">Gender Classification</span>
              <span class="fact-value capitalize">{name.gender}</span>
            </div>

            <div class="fact-row">
              <span class="fact-label">Syllable Count</span>
              <span class="fact-value">{name.syllableCount || 2} Syllables</span>
            </div>
          </div>
        </section>

        <!-- Syllable-by-Syllable Hanja Breakdown -->
        {name.syllables && name.syllables.length > 0 && (
          <section class="editorial-box syllables-box">
            <h2 class="box-heading">Syllable & Character Breakdown</h2>
            <p class="section-lead-text">
              In Sino-Korean names, each syllable carries a distinct Hanja logogram contributing to the combined name virtue:
            </p>

            <div class="syllables-cards-list">
              {name.syllables.map((s, index) => (
                <div class="syllable-detail-card">
                  <div class="syl-left-badge">
                    <span class="syl-index">Syllable {index + 1}</span>
                    <span class="syl-chars">{s.hanja} ({s.hangul})</span>
                    <span class="syl-rom">{s.romanization}</span>
                  </div>

                  <div class="syl-right-info">
                    <h3 class="syl-meaning-title">Meaning: <em>"{s.meaning}"</em></h3>
                    {s.subDefinitions && s.subDefinitions.length > 0 ? (
                      <ul class="sub-definitions-list">
                        {s.subDefinitions.map(def => (
                          <li><strong>{def.term}:</strong> {def.definition}</li>
                        ))}
                      </ul>
                    ) : (
                      <p class="sub-def-fallback">Associated with noble virtue, clarity, and auspicious character in traditional Korean naming philosophy.</p>
                    )}
                    <a href={`/hanja/${encodeURIComponent(s.hangul)}`} class="hanja-lookup-link">
                      View details for Hanja {s.hanja} ({s.hangul}) &rarr;
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Cultural Background & Context -->
        <section class="editorial-box culture-box">
          <h2 class="box-heading">Cultural Background & Usage in Korea</h2>
          <p class="culture-body-text">
            {name.originStory || `${name.english} (${name.hangul}) is an authentic Korean given name widely appreciated for its melodic pronunciation and balanced tonal flow. In South Korea, parents select this name to express aspirations of ${name.overallMeaning.toLowerCase()}`}
          </p>

          <!-- Alternate Hanja Combinations -->
          {name.alternateHanjaList && name.alternateHanjaList.length > 1 && (
            <div class="alternate-hanja-block">
              <h3 class="alt-heading">Alternative Hanja Character Writings for {name.hangul}</h3>
              <p class="alt-sub">Because the Korean language uses logographic Hanja for birth records, the same spoken name {name.hangul} can be registered with different character pairings to yield unique personal meanings:</p>
              
              <div class="alt-hanja-grid">
                {name.alternateHanjaList.map(item => (
                  <div class="alt-item">
                    <span class="alt-hanja font-hanja">{item.hanja}</span>
                    <span class="alt-meaning">{item.literalMeaning}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>

        <!-- Surname Pairing & Harmony -->
        <section class="editorial-box harmony-box">
          <h2 class="box-heading">Surname Harmony & Full Name Examples</h2>
          <p class="section-lead-text">
            In Korean culture, the family surname is spoken first. Here is how <strong>{name.english}</strong> pairs with Korea's most common royal surnames:
          </p>

          <div class="pairings-grid">
            {surnamePairings.map(pair => (
              <div class="pairing-card">
                <span class="full-hangul-text">{pair.fullHangul}</span>
                <strong class="full-english-text">{pair.fullEnglish}</strong>
                <span class="surname-hanja-badge">{pair.hanja} ({pair.surname})</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Related Names Grid -->
        {relatedNames.length > 0 && (
          <section class="related-names-section">
            <h2 class="related-heading">Explore Related Korean {genderLabel.split(' ')[0]} Names</h2>
            <div class="related-cards-grid">
              {relatedNames.map(item => (
                <NameCard name={item} />
              ))}
            </div>
          </section>
        )}

      </main>

      <!-- Sidebar -->
      <aside class="sidebar-container">
        <Sidebar />
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.getElementById('share-name-btn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href);
    alert('Link to this Korean name copied to clipboard!');
  });
</script>

<style>
  .page-wrapper {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .name-hero-profile {
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--brand-teal-surface) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2.5rem;
  }

  .profile-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .badge-cluster {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .profile-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .action-circle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .action-circle-btn:hover {
    border-color: var(--brand-teal);
    transform: scale(1.05);
  }

  .profile-char-block {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .hangul-hero-text {
    font-family: var(--font-korean);
    font-size: 3.75rem;
    font-weight: 900;
    color: var(--text-main);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hanja-hero-text {
    font-family: var(--font-korean);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--accent-indigo);
  }

  .profile-english-name {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--brand-teal-deep);
    margin-bottom: 0.4rem;
  }

  .profile-meaning-lead {
    font-size: 1.15rem;
    color: var(--text-body);
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  .audio-banner-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--brand-teal-border);
    border-radius: var(--radius-md);
    flex-wrap: wrap;
  }

  .audio-instruction {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Editorial Box System */
  .editorial-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-xs);
    margin-bottom: 2.5rem;
  }

  .box-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-lead-text {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Facts Grid */
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .fact-row {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .fact-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.2rem;
  }

  .fact-value {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .font-hangul { font-family: var(--font-hangul); }
  .font-hanja { font-family: var(--font-korean); color: var(--accent-indigo); }
  .capitalize { text-transform: capitalize; }

  /* Syllables Cards */
  .syllables-cards-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .syllable-detail-card {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .syl-left-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 120px;
    padding: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .syl-index {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .syl-chars {
    font-family: var(--font-korean);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-main);
    line-height: 1.1;
  }

  .syl-rom {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    margin-top: 0.25rem;
  }

  .syl-right-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .syl-meaning-title {
    font-size: 1.1rem;
    color: var(--text-main);
    margin-bottom: 0.65rem;
  }

  .syl-meaning-title em {
    font-style: normal;
    color: var(--brand-teal-deep);
    font-weight: 700;
  }

  .sub-definitions-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-body);
    margin-bottom: 1rem;
  }

  .sub-def-fallback {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .hanja-lookup-link {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    margin-top: auto;
  }

  .hanja-lookup-link:hover {
    color: var(--brand-teal);
    text-decoration: underline;
  }

  /* Culture Box */
  .culture-body-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-body);
    margin-bottom: 1.5rem;
  }

  .alternate-hanja-block {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .alt-heading {
    font-size: 1.05rem;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }

  .alt-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .alt-hanja-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .alt-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .alt-hanja {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--accent-indigo);
  }

  .alt-meaning {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Surname Pairings Grid */
  .pairings-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
  }

  .pairing-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 0.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .full-hangul-text {
    font-family: var(--font-korean);
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--text-main);
    margin-bottom: 0.2rem;
  }

  .full-english-text {
    font-size: 0.825rem;
    color: var(--brand-teal-deep);
    margin-bottom: 0.35rem;
  }

  .surname-hanja-badge {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  /* Related Names Section */
  .related-names-section {
    margin-top: 3.5rem;
  }

  .related-heading {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 1.5rem;
  }

  .related-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .name-hero-profile { padding: 1.5rem; }
    .hangul-hero-text { font-size: 2.75rem; }
    .hanja-hero-text { font-size: 1.75rem; }
    .facts-grid { grid-template-columns: 1fr; }
    .syllable-detail-card { flex-direction: column; gap: 1rem; }
    .pairings-grid { grid-template-columns: repeat(2, 1fr); }
    .alt-hanja-grid { grid-template-columns: 1fr; }
    .related-cards-grid { grid-template-columns: 1fr; }
  }
</style>
