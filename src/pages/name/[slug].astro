---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NameCard from '../../components/NameCard.astro';
import { KOREAN_NAMES } from '../../data/names';
import type { KoreanName } from '../../types/name';

export async function getStaticPaths() {
  return KOREAN_NAMES.map((name) => ({
    params: { slug: name.slug },
    props: { name }
  }));
}

export interface Props {
  name: KoreanName;
}

const { name } = Astro.props;

// Sibling Name Ideas
const brotherNames = KOREAN_NAMES.filter(
  (n) => n.gender === 'boy' && n.slug !== name.slug
).slice(0, 3);

const sisterNames = KOREAN_NAMES.filter(
  (n) => n.gender === 'girl' && n.slug !== name.slug
).slice(0, 3);

// Similar names (same gender)
const similarNames = KOREAN_NAMES.filter(
  (n) => n.gender === name.gender && n.slug !== name.slug
).slice(0, 4);

// Top surname pairing combinations
const surnamePairings = [
  { surname: 'Kim', hangul: '김', hanja: '金', fullHangul: `김${name.hangul}`, fullEnglish: `Kim ${name.english.split(' ')[0]}` },
  { surname: 'Lee', hangul: '이', hanja: '李', fullHangul: `이${name.hangul}`, fullEnglish: `Lee ${name.english.split(' ')[0]}` },
  { surname: 'Park', hangul: '박', hanja: '朴', fullHangul: `박${name.hangul}`, fullEnglish: `Park ${name.english.split(' ')[0]}` },
  { surname: 'Choi', hangul: '최', hanja: '崔', fullHangul: `최${name.hangul}`, fullEnglish: `Choi ${name.english.split(' ')[0]}` },
  { surname: 'Jung', hangul: '정', hanja: '鄭', fullHangul: `정${name.hangul}`, fullEnglish: `Jung ${name.english.split(' ')[0]}` },
];

const genderLabel = name.gender === 'boy' ? 'Boy' : name.gender === 'girl' ? 'Girl' : 'Unisex';
const genderBadgeClass = name.gender === 'boy' ? 'badge-boy' : name.gender === 'girl' ? 'badge-girl' : 'badge-unisex';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: `${name.gender === 'boy' ? 'Boy Names' : name.gender === 'girl' ? 'Girl Names' : 'Unisex Names'}`, href: `/${name.gender === 'boy' ? 'boy' : name.gender === 'girl' ? 'girl' : 'unisex'}-names` },
  { label: `${name.english} (${name.hangul})` }
];

// Clean Nicknames
const englishParts = name.english.replace(/[^a-zA-Z\s-]/g, '').split(/[\s-]+/).filter(Boolean);
const baseNicknames = name.nicknames && name.nicknames.length > 0
  ? name.nicknames
  : [
      englishParts[0] ? `${englishParts[0]}ie` : null,
      englishParts[1] ? `${englishParts[1]}ie` : null,
      englishParts[0] || null,
      englishParts[1] || null
    ].filter(Boolean) as string[];

const uniqueNicknames = Array.from(new Set(baseNicknames));

// Fun Facts
const funFacts = [
  {
    title: 'Sibling Harmony (Dollimja)',
    desc: `In Korean family tradition, the syllable "${name.syllables?.[0]?.hangul || name.hangul[0]}" or "${name.syllables?.[1]?.hangul || name.hangul[1] || ''}" is frequently selected as a shared generational marker (Dollimja 돌림자) among siblings to symbolize unity and generational bonds.`
  },
  {
    title: 'Phonetic Balance',
    desc: `Pronounced "${name.revisedRomanization || name.slug}", the name has an open vowel cadence that flows naturally in spoken Korean without sharp consonant clashes.`
  },
  {
    title: 'Civil Registration',
    desc: name.isPureKorean || name.classification === 'pure-korean'
      ? `Officially registered in pure native Hangul script under the Supreme Court of Korea Family Relationship Registration guidelines.`
      : `Both syllables correspond to official Hanja characters authorized for birth records by the Supreme Court of Korea.`
  }
];

const nameSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  'name': name.english,
  'termCode': name.hangul,
  'description': name.overallMeaning,
  'inDefinedTermSet': 'https://www.korean-names.info'
};
---

<BaseLayout
  title={`${name.english} (${name.hangul}) - Korean Name Meaning, Hanja & Pronunciation`}
  description={`Discover the meaning, Hanja characters (${name.hanja || 'Pure Korean'}), pronunciation, and surname harmony for the Korean name ${name.english} (${name.hangul}).`}
  jsonLd={nameSchema}
>
  <div class="container page-wrapper">
    <!-- Breadcrumb Navigation -->
    <nav class="name-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="bc-sep">&gt;</span>
      <a href={`/${name.gender === 'boy' ? 'boy' : name.gender === 'girl' ? 'girl' : 'unisex'}-names`}>
        {name.gender === 'boy' ? 'Korean Boy Names' : name.gender === 'girl' ? 'Korean Girl Names' : 'Korean Unisex Names'}
      </a>
      <span class="bc-sep">&gt;</span>
      <span class="bc-current">{name.english}</span>
    </nav>

    <div class="content-layout">
      <!-- Main Content Column -->
      <main class="main-column">
        
        <!-- The Bump Style: Name Hero Card -->
        <header class="name-profile-hero">
          <div class="hero-top-row">
            <h1 class="hero-name-title">{name.english}</h1>
            <BookmarkButton slug={name.slug} nameEnglish={name.english} size="md" />
          </div>

          <div class="hero-korean-row">
            <span class="hero-hangul-badge">{name.hangul}</span>
            {name.hanja && <span class="hero-hanja-badge">({name.hanja})</span>}
            <div class="hero-audio-inline">
              <AudioPlayer text={name.hangul} size="sm" label="Pronounce" />
              <span class="hero-pronunciation-text">pronounced "{name.revisedRomanization || name.slug}"</span>
            </div>
          </div>

          <!-- 4-Segment Action Bar -->
          <div class="hero-action-bar">
            <a href="/favorites" class="hero-action-item">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              <span>My Favorites</span>
            </a>
            <a href="/names" class="hero-action-item">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
              <span>Explore Lists</span>
            </a>
            <a href="/name-generator" class="hero-action-item">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
              <span>Generator</span>
            </a>
            <a href="/name-finder" class="hero-action-item">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span>Search Names</span>
            </a>
          </div>

          <!-- Tag Pills -->
          <div class="hero-tag-pills">
            <span class={`tag-pill ${genderBadgeClass}`}>{genderLabel} Name</span>
            <span class="tag-pill">
              {name.isPureKorean || name.classification === 'pure-korean' ? 'Pure Native Korean' : 'Sino-Korean (Hanja)'}
            </span>
            {name.popularityRank && name.popularityRank <= 30 ? (
              <span class="tag-pill active">Top {name.popularityRank} Baby Name</span>
            ) : (
              <span class="tag-pill">Popular Korean Name</span>
            )}
            <span class="tag-pill">2-Syllable Name</span>
          </div>

          <!-- Editorial Byline Strip -->
          <div class="hero-byline-strip">
            <div class="byline-left">
              <span class="byline-author">By <strong>Korean Names Editorial Team</strong></span>
              <span class="byline-dot">·</span>
              <span class="byline-date">Updated November 2026</span>
            </div>
            <div class="byline-share">
              <a href={`https://www.facebook.com/sharer/sharer.php?u=https://www.korean-names.info/name/${name.slug}`} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="Share on Facebook" title="Share on Facebook">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href={`https://twitter.com/intent/tweet?url=https://www.korean-names.info/name/${name.slug}&text=Korean%20Name%20${name.english}`} target="_blank" rel="noopener noreferrer" class="share-icon-btn" aria-label="Share on X" title="Share on X">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <button type="button" class="share-icon-btn" id="copy-share-btn" aria-label="Copy link to clipboard" title="Copy link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              </button>
              <a href={`mailto:?subject=Korean%20Name%20${name.english}&body=Check%20out%20the%20meaning%20of%20the%20Korean%20name%20${name.english}:%20https://www.korean-names.info/name/${name.slug}`} class="share-icon-btn" aria-label="Share via Email" title="Email link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </a>
            </div>
          </div>
        </header>

        <!-- Quick Stats Box (The Bump Style) -->
        <section class="quick-stats-box">
          <div class="stat-col">
            <span class="stat-label">Popularity</span>
            <strong class="stat-value">{name.popularityRank ? `#${name.popularityRank}` : 'Top Tier'}</strong>
            <span class="stat-sub">in South Korea</span>
          </div>
          <div class="stat-col">
            <span class="stat-label">Origin</span>
            <strong class="stat-value">{name.isPureKorean || name.classification === 'pure-korean' ? 'Pure Korean' : 'Sino-Korean'}</strong>
            <span class="stat-sub">{name.hanja ? 'Hanja characters' : 'Native vocabulary'}</span>
          </div>
          <div class="stat-col">
            <span class="stat-label">Meaning</span>
            <strong class="stat-value stat-meaning">"{name.overallMeaning}"</strong>
            <span class="stat-sub">Core character virtue</span>
          </div>
        </section>

        <!-- What Does [Name] Mean? -->
        <section class="editorial-box">
          <h2 class="box-heading">What Does {name.english} Mean?</h2>
          <p class="editorial-body">
            <strong>{name.english}</strong> (written as <strong>{name.hangul}</strong> in Korean Hangul{name.hanja ? ` and <strong>${name.hanja}</strong> in Hanja logograms` : ''}) is a beloved Korean given name meaning <strong>"{name.overallMeaning}"</strong>.
          </p>
          <p class="editorial-body">
            {name.originStory || `In traditional and contemporary Korean culture, names are selected with great care to convey parents' heartfelt hopes for their child's future. The combination of syllables in ${name.english} brings together complementary attributes of wisdom, character, and harmony, creating a balanced and auspicious identity.`}
          </p>
        </section>

        <!-- Syllable-by-Syllable Hanja Breakdown -->
        {name.syllables && name.syllables.length > 0 && (
          <section class="editorial-box">
            <h2 class="box-heading">Syllable & Character Breakdown</h2>
            <p class="editorial-body">
              {name.isPureKorean ? (
                `As a native Pure Korean (순우리말) name, each syllable contributes directly to its poetic natural meaning:`
              ) : (
                `In Sino-Korean naming, each syllable represents a distinct Hanja character carrying an individual virtue:`
              )}
            </p>

            <div class="syllables-cards-list">
              {name.syllables.map((s, index) => (
                <div class="syllable-detail-card">
                  <div class="syl-left-badge">
                    <span class="syl-index">Syllable {index + 1}</span>
                    <span class="syl-chars">{s.hangul} {s.hanja ? `(${s.hanja})` : ''}</span>
                    <span class="syl-rom">{s.romanization}</span>
                  </div>

                  <div class="syl-right-info">
                    <h3 class="syl-meaning-title">Character Meaning: <em>"{s.meaning}"</em></h3>
                    {s.subDefinitions && s.subDefinitions.length > 0 ? (
                      <ul class="sub-definitions-list">
                        {s.subDefinitions.map(def => (
                          <li><strong>{def.term}:</strong> {def.definition}</li>
                        ))}
                      </ul>
                    ) : (
                      <p class="sub-def-fallback">Associated with noble virtue, clarity, and auspicious character in traditional Korean naming philosophy.</p>
                    )}
                    {s.hanja && (
                      <a href={`/hanja/${encodeURIComponent(s.hangul)}`} class="hanja-lookup-link">
                        Explore Hanja character {s.hanja} ({s.hangul}) &rarr;
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Multi-Hanja Combinations Matrix -->
        {name.hanjaCombinations && name.hanjaCombinations.length > 0 && (
          <section class="editorial-box">
            <div class="matrix-heading-bar">
              <h2 class="box-heading">Hanja Character Pairings for {name.hangul}</h2>
              <span class="matrix-badge">{name.hanjaCombinations.length} Registered Pairings</span>
            </div>
            <p class="editorial-body">
              Because spoken Korean uses logographic Hanja characters on birth records, different character combinations can be chosen to convey distinct nuances:
            </p>

            <div class="combinations-matrix-list">
              {name.hanjaCombinations.map((combo, idx) => (
                <div class={`combination-card ${combo.isPopularVariant ? 'popular-combo' : ''}`}>
                  <div class="combo-card-header">
                    <div class="combo-chars">
                      <span class="combo-index">Combination #{idx + 1}</span>
                      <span class="combo-hanja font-hanja">{combo.completeHanja}</span>
                      <span class="combo-hangul font-hangul">({name.hangul})</span>
                      {combo.isPopularVariant && <span class="badge badge-gold">Most Popular</span>}
                    </div>
                  </div>

                  <p class="combo-interpretation">
                    <strong>Interpretation:</strong> {combo.combinedInterpretation}
                  </p>

                  <div class="combo-syllables-grid">
                    {combo.syllables.map(s => (
                      <div class="combo-syllable-item">
                        <span class="combo-syl-char font-hanja">{s.hanja}</span>
                        <div class="combo-syl-details">
                          <span class="combo-syl-hangul">{s.hangul}</span>
                          <span class="combo-syl-meaning">"{s.meaning}"</span>
                          <span class="combo-syl-meta">{s.strokeCount} strokes {s.radical ? `· Radical ${s.radical}` : ''}</span>
                        </div>
                      </div>
                    ))}
                  </div>

                  {combo.culturalContext && (
                    <div class="combo-context-note">
                      <span class="context-label">Naming Context:</span> {combo.culturalContext}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Fun Facts About the Name (The Bump Style) -->
        <section class="editorial-box">
          <h2 class="box-heading">Fun Facts About the Name {name.english}</h2>
          <div class="fun-facts-list">
            {funFacts.map((fact, idx) => (
              <div class="fun-fact-item">
                <span class="fact-num">{idx + 1}</span>
                <div class="fact-text-block">
                  <h3 class="fact-title">{fact.title}</h3>
                  <p class="fact-desc">{fact.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Common Nicknames (The Bump Style) -->
        {uniqueNicknames.length > 0 && (
          <section class="editorial-box">
            <h2 class="box-heading">Common Nicknames for {name.english}</h2>
            <p class="editorial-body">
              Affectionate everyday Korean and international nicknames for {name.english}:
            </p>
            <div class="nicknames-pills-wrap">
              {uniqueNicknames.map(nickname => (
                <span class="nickname-pill">{nickname}</span>
              ))}
            </div>
          </section>
        )}

        <!-- Famous People Named [Name] (The Bump Style) -->
        <section class="editorial-box">
          <h2 class="box-heading">Famous People Named {name.english}</h2>
          {name.famousNamesakes && name.famousNamesakes.length > 0 ? (
            <div class="famous-names-list">
              {name.famousNamesakes.map(person => (
                <div class="famous-person-card">
                  <div class="person-info">
                    <h3 class="person-name">{person.name}</h3>
                    <span class="person-role">{person.role}</span>
                    {person.note && <p class="person-note">{person.note}</p>}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="editorial-body">
              The given name <strong>{name.english} ({name.hangul})</strong> is widely recognized in South Korean contemporary society, regularly borne by public figures, scholars, athletes, and characters across modern Korean film and television.
            </p>
          )}
        </section>

        <!-- Sibling Name Ideas (The Bump Style) -->
        <section class="editorial-box sibling-ideas-box">
          <h2 class="box-heading">Sibling Name Ideas for {name.english}</h2>
          <p class="editorial-body">
            Complementary Korean brother and sister names that harmonize with {name.english}:
          </p>

          <div class="sibling-columns-grid">
            <div class="sibling-col">
              <h3 class="sibling-subheading">Brother Names</h3>
              <div class="sibling-names-stack">
                {brotherNames.map(b => (
                  <div class="sibling-mini-card">
                    <div class="mini-card-info">
                      <a href={`/name/${b.slug}`} class="mini-name-link">{b.english}</a>
                      <span class="mini-hangul">{b.hangul}</span>
                      <span class="mini-meaning">"{b.overallMeaning}"</span>
                    </div>
                    <BookmarkButton slug={b.slug} nameEnglish={b.english} size="sm" />
                  </div>
                ))}
              </div>
            </div>

            <div class="sibling-col">
              <h3 class="sibling-subheading">Sister Names</h3>
              <div class="sibling-names-stack">
                {sisterNames.map(s => (
                  <div class="sibling-mini-card">
                    <div class="mini-card-info">
                      <a href={`/name/${s.slug}`} class="mini-name-link">{s.english}</a>
                      <span class="mini-hangul">{s.hangul}</span>
                      <span class="mini-meaning">"{s.overallMeaning}"</span>
                    </div>
                    <BookmarkButton slug={s.slug} nameEnglish={s.english} size="sm" />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <!-- Similar Korean Names (The Bump Style) -->
        <section class="editorial-box">
          <h2 class="box-heading">Similar Korean Names</h2>
          <p class="editorial-body">
            Parents who like <strong>{name.english}</strong> also consider these names:
          </p>
          <div class="similar-names-grid">
            {similarNames.map(item => (
              <NameCard name={item} />
            ))}
          </div>
        </section>

        <!-- Surname Harmony & Full Name Examples -->
        <section class="editorial-box">
          <h2 class="box-heading">Surname Harmony & Full Name Examples</h2>
          <p class="editorial-body">
            In Korean naming tradition, the family surname is always placed first. Here is how <strong>{name.english}</strong> pairs with Korea's most prominent family surnames:
          </p>

          <div class="pairings-grid">
            {surnamePairings.map(pair => (
              <div class="pairing-card">
                <span class="full-hangul-text">{pair.fullHangul}</span>
                <strong class="full-english-text">{pair.fullEnglish}</strong>
                <span class="surname-hanja-badge">{pair.hanja} ({pair.surname})</span>
              </div>
            ))}
          </div>
        </section>

      </main>

      <!-- Sidebar -->
      <aside class="sidebar-container">
        <Sidebar />
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const copyShareBtn = document.getElementById('copy-share-btn');
  copyShareBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      const orig = copyShareBtn.getAttribute('title') || 'Copy link';
      copyShareBtn.setAttribute('title', 'Copied to clipboard!');
      setTimeout(() => { copyShareBtn.setAttribute('title', orig); }, 2000);
    } catch (e) {
      // clipboard unavailable
    }
