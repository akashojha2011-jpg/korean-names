---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQSection from '../../../components/FAQSection.astro';
import { THEME_CATEGORIES } from '../../../data/categories';
import { KOREAN_NAMES } from '../../../data/names';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Korean Names', href: '/names' },
  { label: 'Korean Names and Meanings' }
];

// Calculate live name counts for each theme category
const categoriesWithCounts = THEME_CATEGORIES.map(cat => {
  const count = KOREAN_NAMES.filter(n =>
    n.themes && n.themes.some(t => t.toLowerCase() === cat.slug.toLowerCase())
  ).length;
  return {
    ...cat,
    count
  };
});

// Curated selection of top representative names with rich meanings
const featuredNames = KOREAN_NAMES.slice(0, 36);

// Syllable building blocks reference data
const boySyllables = [
  { hangul: '민', hanja: '敏', rom: 'Min', meaning: 'Clever, sharp-minded, agile', ex: 'Min-jun, Min-woo' },
  { hangul: '준', hanja: '俊', rom: 'Jun / Joon', meaning: 'Talented, handsome, elite', ex: 'Min-jun, Seo-jun' },
  { hangul: '서', hanja: '瑞', rom: 'Seo', meaning: 'Auspicious, good omen, lucky', ex: 'Seo-jun, Seo-jin' },
  { hangul: '우', hanja: '宇', rom: 'Woo', meaning: 'Cosmos, universe, greatness', ex: 'Ji-woo, Hyun-woo' },
  { hangul: '현', hanja: '賢', rom: 'Hyun', meaning: 'Wise, virtuous, worthy', ex: 'Do-hyun, Hyun-jun' },
  { hangul: '도', hanja: '道', rom: 'Do', meaning: 'Righteous path, moral principle', ex: 'Do-jun, Do-hyun' },
  { hangul: '진', hanja: '眞', rom: 'Jin', meaning: 'Truth, genuine, precious', ex: 'Woo-jin, Jin-woo' },
  { hangul: '호', hanja: '浩', rom: 'Ho', meaning: 'Vast, boundless, heroic', ex: 'Min-ho, Jun-ho' }
];

const girlSyllables = [
  { hangul: '지', hanja: '智', rom: 'Ji', meaning: 'Wisdom, intellect, insight', ex: 'Ji-woo, Ji-ah' },
  { hangul: '서', hanja: '瑞', rom: 'Seo', meaning: 'Auspicious, auspiciously timed', ex: 'Seo-ah, Seo-yeon' },
  { hangul: '연', hanja: '蓮', rom: 'Yeon', meaning: 'Lotus flower, graceful beauty', ex: 'Seo-yeon, Ha-yeon' },
  { hangul: '은', hanja: '恩', rom: 'Eun', meaning: 'Grace, kindness, blessing', ex: 'Ha-eun, Eun-ji' },
  { hangul: '하', hanja: '夏 / 荷', rom: 'Ha', meaning: 'Summer, great, lotus petal', ex: 'Ha-eun, Ha-yoon' },
  { hangul: '채', hanja: '彩', rom: 'Chae', meaning: 'Vibrant color, radiant glow', ex: 'Chae-won, Chae-eun' },
  { hangul: '윤', hanja: '潤', rom: 'Yoon', meaning: 'Luster, soft glow, prosperity', ex: 'Seo-yoon, Ha-yoon' },
  { hangul: '아', hanja: '雅', rom: 'Ah', meaning: 'Elegant, refined, graceful', ex: 'Seo-ah, Ji-ah' }
];

const faqs = [
  {
    question: "How do Korean name meanings work?",
    answer: "Most Korean names consist of a one-syllable family surname followed by a two-syllable given name. Each given name syllable is typically associated with a specific Sino-Korean Hanja logogram that confers an individual meaning—such as wisdom (智), grace (恩), or talent (俊). Together, the two syllables form a harmonious composite wish chosen by the parents."
  },
  {
    question: "Can two Korean names with the same pronunciation have different meanings?",
    answer: "Yes, absolutely. Because the Korean alphabet (Hangul) is strictly phonetic, dozens of distinct Hanja logograms share the exact same sound. For instance, the syllable 'Min' can be written as 敏 (clever), 珉 (precious jade), or 民 (the people). Consequently, two individuals named Min-jun may have completely different written meanings on their official birth registry."
  },
  {
    question: "What are Pure Korean names without Hanja meanings?",
    answer: "Pure Korean names (Soon-woori-mal, 순우리말) are modern and traditional names derived directly from native Korean words rather than Chinese Hanja roots. Examples include Haneul (하늘 - Sky/Heaven), Bada (바다 - Sea/Ocean), Areum (아름 - Beauty), and Iseul (이슬 - Dewdrop). They are officially recognized on South Korean civil registries."
  },
  {
    question: "How are Korean names chosen for auspicious fortune?",
    answer: "In traditional Korean onomastics (Seongmyeonghak, 성명학), parents and naming masters evaluate the child's birth date and time under the Four Pillars of Destiny (Saju, 사주). They choose Hanja characters with specific stroke counts and Five Elements (Eum-yang-o-haeng, 음양오행) associations—Wood, Fire, Earth, Metal, or Water—to compensate for any energetic imbalances in the child's astrological chart."
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://www.korean-names.info/names/meaning',
      'url': 'https://www.korean-names.info/names/meaning',
      'name': 'Korean Names and Meanings: Complete Cultural Dictionary',
      'description': 'Comprehensive dictionary of Korean names and meanings. Search verified Hangul orthography, Supreme Court Hanja logograms, syllable meanings, and cultural virtues.',
      'breadcrumb': {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://www.korean-names.info' },
          { '@type': 'ListItem', 'position': 2, 'name': 'Korean Names', 'item': 'https://www.korean-names.info/names' },
          { '@type': 'ListItem', 'position': 3, 'name': 'Korean Names and Meanings', 'item': 'https://www.korean-names.info/names/meaning' }
        ]
      }
    },
    {
      '@type': 'ItemList',
      'name': 'Popular Korean Names with Meanings',
      'description': 'Verified Korean given names with Hangul orthography, official Hanja characters, and English definitions.',
      'numberOfItems': featuredNames.length,
      'itemListElement': featuredNames.map((n, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'DefinedTerm',
          'name': n.english,
          'alternateName': n.hangul,
          'description': `${n.overallMeaning} (Written in Hanja: ${n.hanja || 'Pure Korean'})`,
          'url': `https://www.korean-names.info/name/${n.slug}`
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Korean Names and Meanings: 400+ Authentic Names with Hangul & Hanja"
  description="Discover authentic Korean names and their meanings. Comprehensive dictionary featuring Hangul, Supreme Court Hanja logograms, syllable meanings, and cultural origins."
  jsonLd={schema}
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <!-- Hero Header Optimized for "Korean Names and Meanings" -->
    <header class="meanings-hero">
      <div class="heritage-tag">
        <span class="emblem font-hangul">한국 이름과 의미</span>
        <span>Authoritative Onomastic Reference</span>
      </div>
      <h1 class="hero-title">Korean Names and Meanings</h1>
      <p class="hero-lead">
        In Korean culture, a given name is far more than an identifier—it is an auspicious parental blessing and a lifelong philosophical aspiration.
        Explore verified <strong>Korean name meanings</strong> across official Sino-Korean Hanja characters and poetic Pure Korean native words.
      </p>

      <!-- Quick Metrics Bar -->
      <div class="quick-stats-row">
        <div class="stat-badge">
          <span class="stat-num">{KOREAN_NAMES.length}+</span>
          <span class="stat-lbl">Verified Names</span>
        </div>
        <div class="stat-badge">
          <span class="stat-num">8,000+</span>
          <span class="stat-lbl">Supreme Court Hanja</span>
        </div>
        <div class="stat-badge">
          <span class="stat-num">100%</span>
          <span class="stat-lbl">Cultural Accuracy</span>
        </div>
      </div>
    </header>

    <!-- Section 1: The Two Core Sources of Korean Name Meanings -->
    <section class="sources-card">
      <h2 class="section-title">The Two Sources of Korean Name Meanings</h2>
      <p class="section-desc">
        Understanding the meaning of a Korean name begins with its linguistic classification. Korean given names derive from two distinct traditions:
      </p>

      <div class="sources-grid">
        <div class="source-item sino-card">
          <div class="source-top">
            <span class="source-icon">漢字</span>
            <span class="source-tag">~80% of Korean Names</span>
          </div>
          <h3 class="source-name">Sino-Korean Hanja Names (한자 이름)</h3>
          <p class="source-text">
            Each Hangul syllable corresponds to a specific Chinese character (Hanja) officially approved by the <strong>Supreme Court of Korea</strong>.
            Because dozens of distinct Hanja share the same Korean pronunciation, the exact meaning depends entirely on the character chosen on the birth record.
          </p>
          <div class="example-box">
            <strong>Example:</strong> <em>Min-jun (민준)</em> combines <strong>敏</strong> (Clever / Quick-witted) + <strong>俊</strong> (Talented / Handsome).
          </div>
        </div>

        <div class="source-item pure-card">
          <div class="source-top">
            <span class="source-icon">🇰🇷</span>
            <span class="source-tag">Modern & Resurgent</span>
          </div>
          <h3 class="source-name">Pure Korean Names (순우리말 이름)</h3>
          <p class="source-text">
            Names derived directly from native Korean vocabulary with no Chinese character roots. These names celebrate natural beauty,
            celestial elements, and poetic emotional virtues directly through the Korean language.
          </p>
          <div class="example-box">
            <strong>Example:</strong> <em>Haneul (하늘)</em> means "Sky / Heaven", <em>Bada (바다)</em> means "Ocean", and <em>Areum (아름)</em> means "Beauty".
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Core Given Name Syllable Meanings (Building Blocks) -->
    <section class="syllables-section">
      <div class="section-header-block">
        <span class="section-eyebrow">Anatomy of Given Names</span>
        <h2 class="section-title">Common Korean Name Syllables & Their Meanings</h2>
        <p class="section-desc">
          Most Korean given names combine two complementary syllables. Here are the most prevalent building blocks used in modern Korean naming:
        </p>
      </div>

      <div class="syllables-two-col">
        <!-- Boy Syllables -->
        <div class="syllable-col">
          <h3 class="col-title">👦 Popular Boy Name Syllables</h3>
          <div class="syllables-table-wrap">
            <table class="syllable-table">
              <thead>
                <tr>
                  <th>Syllable</th>
                  <th>Hanja</th>
                  <th>Core Meaning</th>
                  <th>Common In</th>
                </tr>
              </thead>
              <tbody>
                {boySyllables.map(s => (
                  <tr>
                    <td class="td-hangul font-hangul"><strong>{s.hangul}</strong> ({s.rom})</td>
                    <td class="td-hanja font-hangul">{s.hanja}</td>
                    <td class="td-meaning">{s.meaning}</td>
                    <td class="td-examples">{s.ex}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Girl Syllables -->
        <div class="syllable-col">
          <h3 class="col-title">👧 Popular Girl Name Syllables</h3>
          <div class="syllables-table-wrap">
            <table class="syllable-table">
              <thead>
                <tr>
                  <th>Syllable</th>
                  <th>Hanja</th>
                  <th>Core Meaning</th>
                  <th>Common In</th>
                </tr>
              </thead>
              <tbody>
                {girlSyllables.map(s => (
                  <tr>
                    <td class="td-hangul font-hangul"><strong>{s.hangul}</strong> ({s.rom})</td>
                    <td class="td-hanja font-hangul">{s.hanja}</td>
                    <td class="td-meaning">{s.meaning}</td>
                    <td class="td-examples">{s.ex}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Master Directory Table of Korean Names with Meanings -->
    <section class="master-names-section">
      <div class="section-header-block">
        <span class="section-eyebrow">Complete Cultural Lexicon</span>
        <h2 class="section-title">Top Korean Names with Verified Meanings</h2>
        <p class="section-desc">
          Browse verified Korean names with their Hangul orthography, Supreme Court Hanja logograms, and composite English meanings.
        </p>
      </div>

      <div class="names-table-container">
        <table class="names-master-table">
          <thead>
            <tr>
              <th>Name (Romanized)</th>
              <th>Hangul</th>
              <th>Hanja</th>
              <th>Gender</th>
              <th>Overall Meaning</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {featuredNames.map((n) => (
              <tr>
                <td class="col-name">
                  <a href={`/name/${n.slug}`} class="name-table-link">
                    <strong>{n.english}</strong>
                  </a>
                </td>
                <td class="col-hangul font-hangul">{n.hangul}</td>
                <td class="col-hanja font-hangul">{n.hanja || 'Pure Korean'}</td>
                <td class="col-gender">
                  <span class={`gender-pill gender-${n.gender}`}>
                    {n.gender.charAt(0).toUpperCase() + n.gender.slice(1)}
                  </span>
                </td>
                <td class="col-meaning">{n.overallMeaning}</td>
                <td class="col-action">
                  <a href={`/name/${n.slug}`} class="view-profile-btn" aria-label={`View meaning of ${n.english}`}>
                    View Details &rarr;
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="view-all-cta">
        <p>Explore all {KOREAN_NAMES.length} Korean names with instant filter tools by gender, syllable length, and themes:</p>
        <a href="/names" class="btn-primary-lg">Search Complete Names Directory &rarr;</a>
      </div>
    </section>

    <!-- Section 4: Explore Names by Meaning & Virtue Themes -->
    <section class="themes-section">
      <div class="section-header-block">
        <span class="section-eyebrow">Philosophical Virtues</span>
        <h2 class="section-title">Explore Korean Names by Virtue & Theme</h2>
        <p class="section-desc">
          Select a virtue or natural motif to find Korean names embodying that specific philosophical aspiration:
        </p>
      </div>

      <div class="themes-grid">
        {categoriesWithCounts.map(cat => (
          <a href={`/names/meaning/${cat.slug}`} class="theme-card">
            <div class="theme-card-top">
              <span class="theme-icon">{cat.icon}</span>
              <span class="theme-badge">{cat.count} Names</span>
            </div>

            <div class="theme-card-content">
              <div class="theme-names-header">
                <h3 class="theme-name">{cat.name}</h3>
                <span class="theme-korean font-hangul">({cat.koreanName})</span>
              </div>
              <p class="theme-desc">{cat.description}</p>
            </div>

            <div class="theme-card-footer">
              <span class="browse-link">Browse {cat.name} Names &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <FAQSection faqs={faqs} title="Frequently Asked Questions: Korean Name Meanings" renderSchema={true} />

  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  /* Hero Section */
  .meanings-hero {
    background: linear-gradient(135deg, var(--bg-surface) 0%, #EDE6D8 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 3rem 2.5rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .heritage-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-burgundy-surface);
    border: 1px solid var(--color-burgundy-border);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--color-burgundy);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero-lead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 820px;
    margin-bottom: 1.75rem;
  }

  .hero-lead strong {
    color: var(--color-jade);
  }

  .quick-stats-row {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat-badge {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-xs);
  }

  .stat-num {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-jade);
  }

  .stat-lbl {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  /* Sources Card */
  .sources-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2.5rem;
    margin-bottom: 3rem;
    box-shadow: var(--shadow-xs);
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-jade);
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .sources-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .source-item {
    padding: 1.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-surface-warm);
  }

  .source-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .source-icon {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-jade);
  }

  .source-tag {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    color: var(--color-jade);
  }

  .source-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.75rem;
  }

  .source-text {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .example-box {
    padding: 0.75rem 1rem;
    background: var(--bg-surface);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-xs);
    font-size: 0.85rem;
    color: var(--text-main);
  }

  /* Syllables Section */
  .syllables-section {
    margin-bottom: 3.5rem;
  }

  .section-header-block {
    margin-bottom: 2rem;
  }

  .syllables-two-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .col-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  .syllables-table-wrap {
    overflow-x: auto;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-xs);
  }

  .syllable-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .syllable-table th {
    background: var(--bg-surface-warm);
    padding: 0.75rem 1rem;
    font-weight: 700;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-color);
  }

  .syllable-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-muted);
  }

  .syllable-table tr:last-child td {
    border-bottom: none;
  }

  .td-hangul strong {
    color: var(--color-jade);
  }

  .td-hanja {
    font-weight: 700;
    color: var(--color-burgundy);
  }

  .td-meaning {
    color: var(--text-main);
  }

  .td-examples {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Master Names Table Section */
  .master-names-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2.5rem;
    margin-bottom: 3.5rem;
    box-shadow: var(--shadow-xs);
  }

  .names-table-container {
    overflow-x: auto;
    margin-bottom: 2rem;
  }

  .names-master-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .names-master-table th {
    background: var(--bg-surface-warm);
    padding: 0.85rem 1rem;
    font-weight: 700;
    color: var(--text-main);
    border-bottom: 2px solid var(--border-color);
    white-space: nowrap;
  }

  .names-master-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-color);
    vertical-align: middle;
  }

  .names-master-table tr:hover {
    background-color: var(--color-jade-surface);
  }

  .name-table-link {
    color: var(--color-jade);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .name-table-link:hover {
    text-decoration: underline;
  }

  .col-hangul {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .col-hanja {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-burgundy);
  }

  .gender-pill {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .gender-boy {
    background: #E8F0FE;
    color: #1A73E8;
    border: 1px solid #C2E7FF;
  }

  .gender-girl {
    background: #FCE8E6;
    color: #C5221F;
    border: 1px solid #FAD2CF;
  }

  .gender-unisex {
    background: #E6F4EA;
    color: #137333;
    border: 1px solid #CEEAD6;
  }

  .col-meaning {
    color: var(--text-main);
    max-width: 380px;
    line-height: 1.5;
  }

  .view-profile-btn {
    display: inline-block;
