---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Privacy Policy' }
];
---

<BaseLayout
  title="Privacy Policy - KoreanNames.info"
  description="Privacy Policy detailing data collection, cookies, local storage practices, and user privacy compliance on KoreanNames.info."
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <main class="editorial-legal-card">
      <header class="legal-header">
        <h1 class="legal-title">Privacy Policy</h1>
        <p class="legal-date">Last Updated: November 2026</p>
      </header>

      <section class="legal-section">
        <h2>1. Information We Collect</h2>
        <p>At <strong>KoreanNames.info</strong> (accessible from https://www.korean-names.info), user privacy is paramount. We do not require registration, login accounts, or collection of personal identity information to access our full dictionary.</p>
        <ul class="legal-list">
          <li><strong>Local Browser Storage:</strong> Your bookmarked favorite names are saved directly in your web browser (<code>localStorage</code>). This information never leaves your device and is never transmitted to or stored on our servers.</li>
          <li><strong>Standard Server Logs:</strong> Standard web server logs automatically collect non-personal diagnostic metrics (such as browser type, referring URLs, and response timestamps) strictly for infrastructure security, DDOS protection, and technical performance analysis.</li>
        </ul>
      </section>

      <section class="legal-section">
        <h2>2. Cookies & Advertising</h2>
        <p>KoreanNames.info uses minimal session cookies strictly to preserve user display preferences (such as light or dark theme). Third-party advertising partners, including Google AdSense, may use cookies to serve relevant advertisements based on prior visits to this and other websites on the internet.</p>
      </section>

      <section class="legal-section">
        <h2>3. Data Protection Rights (GDPR & CCPA)</h2>
        <p>In accordance with global data protection standards (GDPR, CCPA), visitors have the right to inspect data processing transparency, refuse tracking cookies, and delete locally cached browser data at any time via their browser settings.</p>
      </section>

      <section class="legal-section">
        <h2>4. Contact Us</h2>
        <p>If you have any questions regarding this Privacy Policy, please reach out via our <a href="/contact" class="link-teal">Contact Page</a>.</p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .editorial-legal-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 3rem;
    max-width: 860px;
    margin: 0 auto;
    box-shadow: var(--shadow-xs);
    line-height: 1.7;
  }

  .legal-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
  }

  .legal-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .legal-date {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .legal-section {
    margin-bottom: 2.25rem;
  }

  .legal-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    margin-bottom: 0.75rem;
  }

  .legal-section p {
    font-size: 0.95rem;
    color: var(--text-body);
    margin-bottom: 0.75rem;
  }

  .legal-list {
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.925rem;
    color: var(--text-body);
  }

  .link-teal {
    color: var(--brand-teal-deep);
    font-weight: 700;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .editorial-legal-card { padding: 1.75rem; }
    .legal-title { font-size: 1.75rem; }
  }
</style>
