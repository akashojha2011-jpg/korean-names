---
import BaseLayout from '../layouts/BaseLayout.astro';
import { KOREAN_NAMES } from '../data/names';
import { THEME_CATEGORIES } from '../data/categories';
import { SURNAMES } from '../data/surnames';
import { HANJA_ENTRIES } from '../data/hanja';

const letters = 'abcdefghijklmnopqrstuvwxyz'.split('');
---

<BaseLayout
  title="HTML Sitemap - HanName Korean Names Directory"
  description="Complete index of all programmatic Korean name pages, themes, surnames, Hanja dictionary entries, and letter indexes."
>
  <div class="container page-wrapper">
    <nav class="breadcrumbs">
      <a href="/">Home</a> &rsaquo;
      <span class="current">HTML Sitemap</span>
    </nav>

    <header class="card sitemap-hero">
      <h1 class="sitemap-title">Site Index & Directory Map</h1>
      <p class="sitemap-desc">Comprehensive list of all indexed URLs across HanName.</p>
    </header>

    <div class="sitemap-grid">
      <!-- Section 1: Main Pages & Genders -->
      <section class="card sitemap-section">
        <h2>Main Pages & Gender Directories</h2>
        <ul class="sitemap-list">
          <li><a href="/">Homepage</a></li>
          <li><a href="/gender/boy">Korean Boy Names</a></li>
          <li><a href="/gender/girl">Korean Girl Names</a></li>
          <li><a href="/gender/unisex">Unisex Korean Names</a></li>
          <li><a href="/tools/name-generator">Baby Name Finder Tool</a></li>
          <li><a href="/tools/favorite-names">Saved Favorites</a></li>
        </ul>
      </section>

      <!-- Section 2: Themes -->
      <section class="card sitemap-section">
        <h2>Themes & Categories</h2>
        <ul class="sitemap-list">
          {THEME_CATEGORIES.map(c => (
            <li><a href={`/theme/${c.slug}`}>{c.name} ({c.koreanName})</a></li>
          ))}
        </ul>
      </section>

      <!-- Section 3: Surnames -->
      <section class="card sitemap-section">
        <h2>Korean Family Surnames</h2>
        <ul class="sitemap-list">
          {SURNAMES.map(s => (
            <li><a href={`/surname/${s.slug}`}>{s.english} ({s.hangul} {s.hanja})</a></li>
          ))}
        </ul>
      </section>

      <!-- Section 4: Hanja Dictionary -->
      <section class="card sitemap-section">
        <h2>Hanja Syllables</h2>
        <ul class="sitemap-list">
          {HANJA_ENTRIES.map(h => (
            <li><a href={`/hanja/${h.hangul}`}>{h.hangul} ({h.hanja} - {h.meaning})</a></li>
          ))}
        </ul>
      </section>

      <!-- Section 5: All Name Detail Pages -->
      <section class="card sitemap-section full-width">
        <h2>All Indexed Korean Names ({KOREAN_NAMES.length})</h2>
        <div class="names-link-columns">
          {KOREAN_NAMES.map(n => (
            <a href={`/name/${n.slug}`} class="name-sitemap-link">
              <strong>{n.hangul}</strong> ({n.hanja}) - {n.english}
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrapper { padding-top: 2rem; padding-bottom: 4rem; }
  .breadcrumbs { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem; display: flex; gap: 0.5rem; }
  .sitemap-hero { padding: 2.5rem; margin-bottom: 3rem; }
  .sitemap-title { font-size: 2.2rem; }
  .sitemap-desc { color: var(--text-muted); }
  .sitemap-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .full-width { grid-column: 1 / -1; }
  .sitemap-section h2 { font-size: 1.25rem; margin-bottom: 1rem; color: var(--accent-crimson); }
  .sitemap-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .sitemap-list a { color: var(--text-main); font-weight: 600; font-size: 0.95rem; }
  .sitemap-list a:hover { color: var(--accent-crimson); }
  .names-link-columns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .name-sitemap-link { font-size: 0.9rem; color: var(--text-main); }
  .name-sitemap-link:hover { color: var(--accent-crimson); }
</style>
