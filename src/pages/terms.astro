---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Terms of Service' }
];
---

<BaseLayout
  title="Terms of Service - KoreanNames.info"
  description="Terms of Service governing the educational use, cultural reference, and directory content on KoreanNames.info."
>
  <div class="container page-wrapper">
    <Breadcrumb items={breadcrumbs} />

    <main class="editorial-legal-card">
      <header class="legal-header">
        <h1 class="legal-title">Terms of Service</h1>
        <p class="legal-date">Last Updated: November 2026</p>
      </header>

      <section class="legal-section">
        <h2>1. Acceptance of Terms</h2>
        <p>By accessing and utilizing <strong>KoreanNames.info</strong>, you accept and agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the website.</p>
      </section>

      <section class="legal-section">
        <h2>2. Educational & Reference Nature</h2>
        <p>The materials, dictionary definitions, Hanja logograms, phonetic transcriptions, and cultural articles published on KoreanNames.info are provided strictly for educational, informational, and linguistic reference.</p>
        <p>While we make every effort to cross-reference entries against official legal registries (such as the Supreme Court of Korea Approved Hanja list), parents and individuals should verify exact legal registration requirements with local civil registration authorities when registering official birth certificates.</p>
      </section>

      <section class="legal-section">
        <h2>3. Intellectual Property</h2>
        <p>The compilation, categorization, editorial summaries, design system, and custom software tools on KoreanNames.info are protected by copyright and intellectual property laws. Content may not be scraped or reproduced for mass automated generation without explicit written permission.</p>
      </section>

      <section class="legal-section">
        <h2>4. Contact & Inquiries</h2>
        <p>For questions or licensing inquiries regarding these terms, please contact us through our <a href="/contact" class="link-teal">Contact Page</a>.</p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .editorial-legal-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 3rem;
    max-width: 860px;
    margin: 0 auto;
    box-shadow: var(--shadow-xs);
    line-height: 1.7;
  }

  .legal-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
  }

  .legal-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .legal-date {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .legal-section {
    margin-bottom: 2.25rem;
  }

  .legal-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    margin-bottom: 0.75rem;
  }

  .legal-section p {
    font-size: 0.95rem;
    color: var(--text-body);
    margin-bottom: 0.75rem;
  }

  .link-teal {
    color: var(--brand-teal-deep);
    font-weight: 700;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .editorial-legal-card { padding: 1.75rem; }
    .legal-title { font-size: 1.75rem; }
  }
</style>
