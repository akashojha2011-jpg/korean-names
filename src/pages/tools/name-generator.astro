---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NameGeneratorModal from '../../components/NameGeneratorModal.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/name-generator' },
  { label: 'Baby Name Generator' },
];

const generatorFAQs = [
  {
    question: 'How does the Korean baby name generator match surnames?',
    answer: 'The tool analyzes the phonetic transition between your selected family surname (성) and the initial consonant of the given name. In Korean phonetics (발음오행), avoiding awkward consonant clashes between the surname\'s final consonant (받침) and the first syllable of the given name is essential for a smooth, natural flow.',
  },
  {
    question: 'Are all names generated by this tool officially recognized in South Korea?',
    answer: 'Yes. All given names in our database are drawn from verified Sino-Korean syllables approved by the Supreme Court of the Republic of Korea (대법원 인명용 한자) or well-established native Korean (Soon-woori-mal) words.',
  },
  {
    question: 'Can Korean names be used for both boys and girls?',
    answer: 'While many Korean names have traditional gender connotations based on their Hanja meanings (e.g., characters representing strength or honor for boys, and beauty or grace for girls), numerous contemporary names like Ha-eun, Ji-woo, and Min-seo are widely recognized as unisex.',
  },
  {
    question: 'What is the role of Hanja characters in Korean given names?',
    answer: 'Most Korean given names are Sino-Korean, meaning each syllable is rooted in a specific Hanja (Chinese character). The same spoken Korean name (e.g., Min-jun) can have dozens of distinct character combinations, each imparting a unique parental wish or personal meaning.',
  },
];
---

<BaseLayout
  title="Korean Baby Name Generator & Surname Harmony Finder | HanName"
  description="Generate verified Korean baby names based on your family surname, preferred gender, and vibe. Discover phonetic flow, Hanja character harmony, and authentic meanings."
>
  <div class="tool-page-container">
    <Breadcrumb items={breadcrumbItems} />

    <header class="tool-hero">
      <div class="hero-badge">✨ Interactive Linguistic Tool</div>
      <h1 class="tool-hero-title">Korean Baby Name Generator & Harmony Finder</h1>
      <p class="tool-hero-desc">
        Pair your family surname with culturally authentic given names. Discover harmonious phonetic combinations, examine Hanja logograms, and find names with deep familial significance.
      </p>
    </header>

    <NameGeneratorModal />

    <!-- Educational FAQ section -->
    <section class="tool-faq-section card">
      <h2 class="faq-main-title">Frequently Asked Questions About Korean Baby Naming</h2>
      <div class="faq-accordion-list">
        {generatorFAQs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-summary">
              <span>{faq.question}</span>
              <span class="faq-chevron" aria-hidden="true">&darr;</span>
            </summary>
            <div class="faq-content">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tool-page-container {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem 1.5rem;
  }

  .tool-hero {
    margin-top: 1.5rem;
    margin-bottom: 2.75rem;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--brand-teal-deep);
    background: var(--brand-teal-surface);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.85rem;
  }

  .tool-hero-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--text-main);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .tool-hero-desc {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
  }

  .tool-faq-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    margin-top: 3.5rem;
  }

  .faq-main-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--brand-teal);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.25rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    font-size: 1.1rem;
    color: var(--brand-teal);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-content {
    padding: 0 1.25rem 1.25rem 1.25rem;
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .faq-content p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .tool-hero-title { font-size: 2rem; }
    .tool-faq-section { padding: 1.5rem; }
  }
</style>
